diff --git a/runtime/ap_event.c b/runtime/ap_event.c
new file mode 100644
index 0000000..abb926e
--- /dev/null
+++ b/runtime/ap_event.c
@@ -0,0 +1,231 @@
+// Archipelago: received items handed to Link with the game's own item-get scene, at once, wherever he is
+// (runtime/ui/ap_client.mm "!demo"). The overlay (botw_ap tools/give_trigger.py) has the event Archipelago<AP_Dispatch>:
+// the scene for the item whose AP_Q<n> flag is on. This starts it the way the game starts its own scripted events
+// (Demo025_0 after a load, Demo006_0...): the event manager's start by name (1.9.0 0x7000d14be4; x0 an actor or NULL,
+// x1 / x2 the flow and entry as sead::SafeStrings, x3 a 3x4 matrix where it happens - the game passes an actor's,
+// +0x398 -, w4 / w5 flags, as Demo006_0 has them; returns whether the event manager took it). The game thread calls
+// it from rt_item_tick (runtime/items.c), every frame in play, as long as a start is asked for and refused.
+//
+// The function is found once in main's code by its start, checked by the event manager global it loads (g_site
+// event_mgr), instead of a tools/game_sites.py site: a new site regenerates the whole game library.
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <zlib.h>
+
+#include "cpu.h"
+#include "game_sites.h"
+#include "hle.h"
+#include "rt.h"
+
+static const struct { uint32_t w, m; } START[] = {
+    {0xa9ba7bfd, ~0u}, {0xa9016ffc, ~0u}, {0x910003fd, ~0u}, {0xa90267fa, ~0u}, {0xa9035ff8, ~0u}, {0xa90457f6, ~0u},
+    {0xa9054ff4, ~0u}, {0xd106c3ff, ~0u}, {0x90000008, 0x9f00001f}, {0x91000108, 0xffc003ff}, {0xf9400113, ~0u},
+};
+enum { N_START = sizeof START / sizeof *START };
+
+static uint64_t g_fn;
+static pthread_once_t g_once = PTHREAD_ONCE_INIT;
+static atomic_int g_wanted;
+static int g_wait;  // (game thread) frames until the next try after a refusal
+
+RT_ON_RESET(ap_event_reset) { atomic_store(&g_wanted, 0); g_wait = 0; }
+
+// The adrp at a + 0x20 with the add after it: the address they make
+static uint64_t adrp_add(uint64_t a) {
+    uint32_t adrp = *(const uint32_t *)(uintptr_t)a, add = *(const uint32_t *)(uintptr_t)(a + 4);
+    int64_t imm = (int64_t)((((uint64_t)adrp >> 5) & 0x7ffff) << 2 | (((uint64_t)adrp >> 29) & 3));
+    if (imm & (1 << 20)) imm -= 1 << 21;
+    return (a & ~0xfffull) + (uint64_t)(imm << 12) + ((add >> 10) & 0xfff);
+}
+
+static void find(void) {
+    if (!g_site.main_end || !g_site.event_mgr) return;
+    uint64_t found = 0;
+    int hits = 0;
+    for (uint64_t a = MAIN_BASE; a + 4 * N_START <= g_site.main_end; a += 4) {
+        int k = 0;
+        while (k < N_START && (*(const uint32_t *)(uintptr_t)(a + 4 * k) & START[k].m) == START[k].w) k++;
+        if (k == N_START && adrp_add(a + 0x20) == g_site.event_mgr) found = a, hits++;
+    }
+    g_fn = hits == 1 ? found : 0;
+    LOG("[ap] event start: %s\n", g_fn ? "found" : hits ? "ambiguous" : "not in this game version");
+}
+
+bool ap_event_available(void) {
+    pthread_once(&g_once, find);
+    return g_fn != 0;
+}
+
+void ap_event_request(void) { atomic_store(&g_wanted, 1); }
+
+// (game thread; c at a function's entry: its stack below sp is free) sstr_vt: sead::SafeString's vtable
+void rt_ap_event_tick(Cpu *c, uint64_t sstr_vt) {
+    if (!atomic_load_explicit(&g_wanted, memory_order_relaxed)) return;
+    if (g_wait > 0) { g_wait--; return; }
+    if (!ap_event_available() || !g_site.player_actor || !g_site.player_info) { atomic_store(&g_wanted, 0); return; }
+    uint64_t pinfo = LD64(g_site.player_info), buf = (c->sp - 0x100) & ~15ull;
+    if (!pinfo || buf < GUEST_LO || c->sp > GUEST_HI) return;
+    Cpu *call = malloc(sizeof *call);
+    if (!call) return;
+    *call = *c;
+    call->sp = buf;
+    call->x[0] = pinfo, call->x[1] = call->x[2] = call->x[3] = 0;
+    guest_call(call, g_site.player_actor);
+    uint64_t player = call->x[0];
+    if (player < GUEST_LO || player + 0x3d0 > GUEST_HI) { free(call); g_wait = 30; return; }
+    memcpy((void *)(uintptr_t)(buf + 0x40), "Archipelago", 12);
+    memcpy((void *)(uintptr_t)(buf + 0x60), "AP_Dispatch", 12);
+    uint64_t *s = (uint64_t *)(uintptr_t)buf;
+    s[0] = sstr_vt, s[1] = buf + 0x40, s[2] = sstr_vt, s[3] = buf + 0x60;
+    *call = *c;
+    call->sp = buf;
+    call->x[0] = 0, call->x[1] = buf, call->x[2] = buf + 0x10, call->x[3] = player + 0x398;
+    call->x[4] = 1, call->x[5] = 0;
+    guest_call(call, g_fn);
+    bool took = call->x[0] & 1;
+    free(call);
+    if (took) atomic_store(&g_wanted, 0);
+    else g_wait = 15;  // (busy: another event, a menu...)
+    LOG("[ap] item scene: %s\n", took ? "started" : "not now");
+}
+
+// The pouch, from the game thread: Archipelago Items out of it, and what the shops sold (shop sanity).
+//  - Archipelago Items (Item_AP_00, botw_ap tools/ap_item.py) only stand for a check, sent by the flag of whatever gave
+//    one: the pouch doesn't keep them. Once a second, outside events, an entry of it is marked gone (count 0, not in
+//    the inventory: what the pause menu's throw-away leaves, without its dropping one on the ground) and the game's own
+//    sweep after a throw-away (g_site pouch_cleanup) recycles it, rebuilds the lists and writes the pouch to the save.
+//  - A shop slot's own Archipelago Item (Item_AP_<hex>, runtime/ap_shop.c) taken out sets the slot's saved flag
+//    AP_Shop_<hex> - its check; bought again (a merchant's list read before), the good it stands for is given instead.
+//  - A shopkeeper's talk is an event named after its actor. When one ends with more of an item in the pouch than just
+//    before it, that item was bought there: the slot's saved flag AP_Shop_<crc32 of "actor/item", hex> goes on (botw_ap
+//    tools/shop_sanity.py adds those flags; a talk with someone who isn't a shopkeeper finds none). How many: a stack's
+//    count, or the entries of a weapon, bow, shield or armor (one each).
+// pmdm: the pause menu data (its mutex at +0x28, page count at +0x44498: runtime/quick_drop_action.c, 1.9.0).
+typedef struct { char name[64]; int n; } Stock;
+enum { STOCK_MAX = 480 };
+static Stock g_before[STOCK_MAX];
+static int g_nbefore = -1, g_pouch_wait;  // (-1: no picture of the pouch yet)
+static uint64_t g_shop_ev;
+static Stock g_bought[16];  // (shop slots' Archipelago Items taken out of the pouch: runtime/ap_shop.c)
+static int g_nbought;
+static char g_shop_talk[64];
+RT_ON_RESET(ap_pouch_reset) { g_pouch_wait = 0, g_nbefore = -1, g_shop_ev = 0; }
+
+// The Thief Trap (runtime/ui/ap_client.mm): the next pouch walk takes one weapon, bow or shield Link isn't holding,
+// picked at random (never the Master Sword); with none, nothing
+static atomic_int g_thief;
+void ap_thief_request(void) { atomic_store(&g_thief, 1); }
+
+static void stock_add(Stock *s, int *n, const char *name, int k) {
+    for (int i = 0; i < *n; i++)
+        if (!strcmp(s[i].name, name)) { s[i].n += k; return; }
+    if (*n < STOCK_MAX) snprintf(s[*n].name, sizeof s[*n].name, "%s", name), s[(*n)++].n = k;
+}
+
+// The pouch's contents into `out` (Archipelago Items taken out first); -1: not now
+static int pouch_walk(Cpu *c, uint64_t pmdm, Stock *out) {
+    if (!pmdm || pmdm < GUEST_LO || pmdm + 0x45000 > GUEST_HI || strcmp(g_game_version, "1.9.0") ||
+        !g_site.pouch_lock || !g_site.pouch_unlock || !g_site.pouch_page_count || !g_site.pouch_page_item ||
+        !g_site.pouch_cleanup) return -1;
+    Cpu *call = malloc(sizeof *call);
+    if (!call) return -1;
+#define POUCH(fn, a, b, d) (*call = *c, call->sp = (c->sp - 0x100) & ~15ull, call->x[0] = (a), call->x[1] = (b), \
+                            call->x[2] = (d), call->x[3] = 0, guest_call(call, g_site.fn), call->x[0])
+    POUCH(pouch_lock, pmdm + 0x28, 0, 0);
+    int tabs = (int32_t)LD32(pmdm + 0x44498), gone = 0, n = 0, nloot = 0;
+    uint64_t loot[64];  // (what the thief may take)
+    for (int tab = 0; tab < tabs && tabs <= 50; tab++) {
+        int cnt = (int32_t)POUCH(pouch_page_count, pmdm, tab, 0);
+        for (int slot = 0; slot < cnt && cnt <= 20; slot++) {
+            uint64_t item = POUCH(pouch_page_item, pmdm, tab, slot), name;
+            if (item < GUEST_LO || item + 0x38 > GUEST_HI || !LD8(item + 0x25)) continue;
+            name = LD64(item + 0x30);
+            if (name < GUEST_LO || name + 64 > GUEST_HI) continue;
+            const char *nm = (const char *)(uintptr_t)name;
+            if (!strncmp(nm, "Item_AP_", 8)) {
+                gone += (int32_t)LD32(item + 0x20);
+                if (strcmp(nm, "Item_AP_00") && memchr(nm, 0, 64)) stock_add(g_bought, &g_nbought, nm, (int32_t)LD32(item + 0x20));
+                ST32(item + 0x20, 0);
+                ST8(item + 0x25, 0);
+                continue;
+            }
+            int type = (int32_t)LD32(item + 0x18), value = (int32_t)LD32(item + 0x20);
+            bool each = type == 0 || type == 1 || (type >= 3 && type <= 6);  // (sword, bow, shield, armor: one each)
+            if (memchr(nm, 0, 64)) stock_add(out, &n, nm, each ? 1 : value);
+            if ((type == 0 || type == 1 || type == 3) && !LD8(item + 0x24) && nloot < 64 && memchr(nm, 0, 64) &&
+                strcmp(nm, "Weapon_Sword_070"))
+                loot[nloot++] = item;
+        }
+    }
+    bool thief = atomic_exchange(&g_thief, 0);
+    if (thief && !nloot) LOG("[ap] thief: nothing to take (only what Link holds)\n");
+    if (thief && nloot) {
+        uint64_t item = loot[rand() % nloot];
+        LOG("[ap] thief: took %s\n", (const char *)(uintptr_t)LD64(item + 0x30));
+        ST32(item + 0x20, 0);
+        ST8(item + 0x25, 0);
+        gone++;
+    }
+    if (gone) POUCH(pouch_cleanup, pmdm, 0, 0);
+    POUCH(pouch_unlock, pmdm + 0x28, 0, 0);
+#undef POUCH
+    free(call);
+    if (gone) LOG("[ap] pouch: %d Archipelago Item(s) taken out\n", gone);
+    return n;
+}
+
+void rt_ap_pouch_tick(Cpu *c, uint64_t pmdm) {
+    extern const char *framepace_event_name(void);
+    extern bool gdt_get(uint32_t hash, int32_t *out), gdt_change(uint32_t hash, double d, bool set);
+    uint64_t evt = g_site.event_mgr ? LD64(g_site.event_mgr) : 0, ev = evt ? LD64(evt + 0x1d2b8) : 0;
+    if (ev) {
+        if (ev != g_shop_ev) {  // (an event began: whose)
+            g_shop_ev = ev;
+            snprintf(g_shop_talk, sizeof g_shop_talk, "%s", framepace_event_name());
+        }
+        return;
+    }
+    bool ended = g_shop_ev != 0;
+    g_shop_ev = 0;
+    if (!ended && ++g_pouch_wait < 30) return;
+    g_pouch_wait = 0;
+    static Stock now[STOCK_MAX];
+    g_nbought = 0;
+    int n = pouch_walk(c, pmdm, now);
+    if (n < 0) return;
+    // a shop slot's Archipelago Item: its check; bought again (a list read before that), the good it stands for
+    extern uint32_t ap_shop_flag(const char *ap);
+    extern const char *ap_shop_good(const char *ap);
+    extern int items_give_actor(const char *actor, int count);
+    for (int i = 0; i < g_nbought; i++) {
+        uint32_t h = ap_shop_flag(g_bought[i].name);
+        int32_t v = 0;
+        const char *good = ap_shop_good(g_bought[i].name);
+        if (!h || !gdt_get(h, &v)) continue;
+        if (!v && gdt_change(h, 1, true)) LOG("[ap] shop: %s bought (its check)\n", g_bought[i].name);
+        else if (v && good) LOG("[ap] shop: %s bought again: %s x%d (%d)\n", g_bought[i].name, good, g_bought[i].n,
+                                items_give_actor(good, g_bought[i].n));
+    }
+    if (ended && g_nbefore >= 0 && g_shop_talk[0]) {
+        for (int i = 0; i < n; i++) {
+            int had = 0;
+            for (int k = 0; k < g_nbefore; k++)
+                if (!strcmp(g_before[k].name, now[i].name)) had = g_before[k].n;
+            if (now[i].n <= had) continue;
+            char slot[160], flag[32];
+            snprintf(slot, sizeof slot, "%s/%s", g_shop_talk, now[i].name);
+            snprintf(flag, sizeof flag, "AP_Shop_%08x", (uint32_t)crc32(0, (const Bytef *)slot, (uInt)strlen(slot)));
+            uint32_t h = (uint32_t)crc32(0, (const Bytef *)flag, (uInt)strlen(flag));
+            int32_t v = 0;
+            if (gdt_get(h, &v) && !v && gdt_change(h, 1, true))
+                LOG("[ap] shop: %s sold %s (%s)\n", g_shop_talk, now[i].name, flag);
+        }
+    }
+    memcpy(g_before, now, sizeof *now * n);
+    g_nbefore = n;
+}
diff --git a/runtime/ap_region.c b/runtime/ap_region.c
new file mode 100644
index 0000000..f704b43
--- /dev/null
+++ b/runtime/ap_region.c
@@ -0,0 +1,176 @@
+// Archipelago's region lock (worlds/botw Region Lock; botw_ap tools/regions.py): Hyrule opens region by region, the
+// areas of its 15 Sheikah Towers - the game's own grid, Ecosystem/MapTower.sbeco in Bootup.pack: rows `step` metres
+// apart from z = -4000, each a list of (region, length) runs across the map from x = -5000. AP_RegionLock on (the client
+// sets it from the slot) and AP_Region_<n> off: region n is locked (the Great Plateau's never is; botw_ap
+// tools/shop_sanity.py adds those saved flags, a region's Map item sets its own).
+//
+// As in the Lost Woods, Link nearing a locked region walks into thickening fog (ap_region_fog, drawn by
+// runtime/ui/ap_client.mm), and stepping into one whites it out: he is back where he last stood clear of it (25 m, on
+// the ground; else just before the border). Only on foot across a border: not in a shrine (IsInside_Dungeon), not where a load put him (then: the fog).
+// The game thread, every frame in play (runtime/items.c rt_item_tick).
+#include <math.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <zlib.h>
+
+#include "control_cells.h"
+#include "control_mem.h"
+#include "game_sites.h"
+#include "hle.h"
+#include "rt.h"
+#include "services/archive.h"
+
+uint8_t *fs_game_file(const char *path, size_t *out_n);  // runtime/services/fs.c
+bool gdt_get(uint32_t hash, int32_t *out);               // runtime/gdt_flags.c
+void ap_note(const char *text);                          // runtime/ui/ap_client.mm
+
+enum { PLATEAU_REGION = 6, NREGIONS = 15, FOG_RADIUS = 70 };  // (FOG_RADIUS: metres from a locked region the fog starts)
+static const char *const REGION_NAMES[NREGIONS] = {"Hebra", "Tabantha", "Gerudo", "Wasteland", "Woodland", "Central",
+    "Great Plateau", "Dueling Peaks", "Lake", "Eldin", "Akkala", "Lanayru", "Hateno", "Faron", "Ridgeland"};
+
+typedef struct { int16_t x1; uint8_t r; } Run;  // (a run ends at x1)
+static Run *g_runs;      // every row's runs, in order
+static uint32_t *g_row;  // where each row's runs start (rows + 1)
+static int g_rows = -1, g_step;
+static pthread_once_t g_grid_once = PTHREAD_ONCE_INIT;
+
+static void grid_load(void) {
+    size_t pn = 0, n = 0;
+    uint32_t doff, s, e, h[4];
+    uint8_t *pack = fs_game_file("Pack/Bootup.pack", &pn), *d = NULL;
+    if (pack && sarc_find(pack, pn, "Ecosystem/MapTower.sbeco", &doff, &s, &e) >= 0) d = yaz0_unpack(pack + doff + s, e - s, &n);
+    free(pack);
+    if (!d || n < 16 || (memcpy(h, d, 16), h[0] != 0x00112233) || !h[1] || !h[2] || n < 16 + 4ull * h[1]) {
+        free(d);
+        LOG("[ap] regions: no grid\n");
+        return;
+    }
+    uint32_t rows = h[1], base = 16 + 4 * rows, total = (uint32_t)(n - base) / 4, k = 0;
+    g_runs = malloc(sizeof *g_runs * (total ? total : 1));
+    g_row = malloc(sizeof *g_row * (rows + 1));
+    if (!g_runs || !g_row) { free(d); return; }
+    for (uint32_t r = 0; r < rows; r++) {
+        uint32_t a, b = (uint32_t)(n - base) / 2;
+        memcpy(&a, d + 16 + 4 * r, 4);
+        if (r + 1 < rows) memcpy(&b, d + 16 + 4 * (r + 1), 4);
+        g_row[r] = k;
+        int x = -5000;
+        for (uint64_t o = base + 2ull * a; o + 4 <= base + 2ull * b && o + 4 <= n && k < total; o += 4) {
+            uint16_t v, len;
+            memcpy(&v, d + o, 2), memcpy(&len, d + o + 2, 2);
+            x += len;
+            g_runs[k++] = (Run){(int16_t)x, (uint8_t)v};
+        }
+    }
+    g_row[rows] = k, g_rows = (int)rows, g_step = (int)h[2];
+    free(d);
+    LOG("[ap] regions: %d rows of %d m\n", g_rows, g_step);
+}
+
+static int region_at(float x, float z) {  // (-1: no grid)
+    pthread_once(&g_grid_once, grid_load);
+    if (g_rows <= 0) return -1;
+    int r = (int)floorf((z + 4000) / g_step);
+    r = r < 0 ? 0 : r >= g_rows ? g_rows - 1 : r;
+    for (uint32_t k = g_row[r]; k < g_row[r + 1]; k++)
+        if (x < g_runs[k].x1) return g_runs[k].r;
+    return g_row[r + 1] > g_row[r] ? g_runs[g_row[r + 1] - 1].r : -1;
+}
+
+static int32_t flag(const char *name) {  // (-1: no such flag here: not this overlay)
+    int32_t v = 0;
+    return gdt_get((uint32_t)crc32(0, (const Bytef *)name, (uInt)strlen(name)), &v) ? v : -1;
+}
+
+static bool region_open(int r) {
+    char n[24];
+    snprintf(n, sizeof n, "AP_Region_%02d", r);
+    return r < 0 || r >= NREGIONS || r == PLATEAU_REGION || flag(n) == 1;
+}
+
+// (the map tracker, runtime/ui/ap_client.mm: where Link is)
+bool ap_player_xz(float *x, float *z) {
+    uint64_t pinfo = g_site.player_info ? LD64(g_site.player_info) : 0;
+    if (!pinfo) return false;
+    *x = *(float *)(uintptr_t)(pinfo + 0x88), *z = *(float *)(uintptr_t)(pinfo + 0x90);
+    return true;
+}
+
+static _Atomic float g_fog;
+float ap_region_fog(void) { return atomic_load(&g_fog); }
+
+static struct { float safe[3], prev[3], level; int phase, frames, steady, blocked; bool have_safe, have_prev; } rl;
+RT_ON_RESET(ap_region_reset) { memset(&rl, 0, sizeof rl); atomic_store(&g_fog, 0.f); }
+
+// The nearest locked ground: 0 (here) to 1 (FOG_RADIUS away or more)
+static float locked_near(float x, float z) {
+    for (int ring = 1; ring <= 7; ring++) {
+        float d = ring * (FOG_RADIUS / 7.f);
+        for (int a = 0; a < 16; a++) {
+            float t = a * 0.39269908f;
+            if (!region_open(region_at(x + d * cosf(t), z + d * sinf(t)))) return (d - FOG_RADIUS / 7.f) / FOG_RADIUS;
+        }
+    }
+    return 1;
+}
+
+void rt_ap_region_tick(void) {
+    uint64_t pinfo = g_site.player_info ? LD64(g_site.player_info) : 0;
+    if (!pinfo || flag("AP_RegionLock") != 1 || flag("IsInside_Dungeon") == 1) {
+        rl.have_prev = false, rl.phase = 0, rl.level = 0;
+        atomic_store(&g_fog, 0.f);
+        return;
+    }
+    uint64_t evt = g_site.event_mgr ? LD64(g_site.event_mgr) : 0;
+    if ((evt && LD64(evt + 0x1d2b8)) || (g_site.pause_state && LD32(g_site.pause_state))) return;  // (as it was)
+    float p[3] = {*(float *)(uintptr_t)(pinfo + 0x88), *(float *)(uintptr_t)(pinfo + 0x8c), *(float *)(uintptr_t)(pinfo + 0x90)};
+    // walked in: from open ground a step away the frame before. Not a load's jump, and not the place an item scene's
+    // start reads for a moment (Link was turned back from Akkala standing at the Great Plateau, then the scene's end
+    // put him back: there was never a frame on open ground next to it)
+    bool walked = rl.have_prev && fabsf(p[0] - rl.prev[0]) < 6 && fabsf(p[2] - rl.prev[2]) < 6 &&
+                  region_open(region_at(rl.prev[0], rl.prev[2]));
+    rl.steady = rl.have_prev && fabsf(p[1] - rl.prev[1]) < 0.05f ? rl.steady + 1 : 0;  // (on the ground: not in the air)
+    float target = 0;
+    if (rl.phase == 0) {
+        int r = region_at(p[0], p[2]);
+        if (!region_open(r)) {
+            if (walked) {  // (in: white it out, then back where he last stood clear of it, or just before the border)
+                if (!rl.have_safe) memcpy(rl.safe, rl.prev, sizeof rl.safe);
+                rl.phase = 1, rl.frames = 0, rl.blocked = r;
+                LOG("[ap] regions: Link walked into %s\n", REGION_NAMES[r]);
+            }
+            target = 0.4f;  // (put there by a load: the fog only - light, so he can find his way out)
+        } else {
+            float near = locked_near(p[0], p[2]);
+            target = (1 - near) * 0.35f;  // (a light haze that thickens: he must still see where he goes)
+            if (near >= 0.35f && rl.steady >= 10) memcpy(rl.safe, p, sizeof p), rl.have_safe = true;  // (25 m clear, on the ground)
+        }
+    }
+    if (rl.phase == 1) {  // white out, then back where he last stood clear of it
+        target = 1;
+        if (rl.level >= 0.99f && ++rl.frames > 6) {
+            uint64_t a = control_cell_addr(&control_cell_player_pos);
+            float at[3];
+            if (a && control_mem_peek(a, at, sizeof at) && fabsf(at[0] - p[0]) < 1 && fabsf(at[2] - p[2]) < 1 &&
+                control_mem_poke(a, rl.safe, sizeof rl.safe)) {
+                char msg[96];
+                snprintf(msg, sizeof msg, "The fog is too thick to go on. You need the %s Map.", REGION_NAMES[rl.blocked]);
+                ap_note(msg);
+                LOG("[ap] regions: Link turned back from %s\n", REGION_NAMES[rl.blocked]);
+                memcpy(p, rl.safe, sizeof p);
+            }
+            rl.phase = 2, rl.frames = 0;
+        }
+    } else if (rl.phase == 2) {  // white a moment longer, then clearing
+        target = ++rl.frames < 25 ? 1 : 0;
+        if (rl.frames >= 25 && rl.level < 0.02f) rl.phase = 0;
+    }
+    rl.level += (target - rl.level) * (target > rl.level ? (rl.phase == 1 ? 0.12f : 0.05f) : 0.03f);  // (in fast, out slow)
+    atomic_store(&g_fog, rl.level);
+    memcpy(rl.prev, p, sizeof p), rl.have_prev = true;
+}
diff --git a/runtime/ap_shop.c b/runtime/ap_shop.c
new file mode 100644
index 0000000..515e4e8
--- /dev/null
+++ b/runtime/ap_shop.c
@@ -0,0 +1,85 @@
+// Archipelago shop sanity: every shop slot sells its own Archipelago Item (Item_AP_<hex>, botw_ap tools/shop_items.py)
+// until it's bought, then the shop's own good again. On a counter the map does that (a link tag on the slot's saved
+// flag AP_Shop_<hex>); a merchant's list is in the shopkeeper's actor pack, so it is read here: the overlay folder's
+// ap_shops.txt says where in which pack each slot's Archipelago Item is named ("<pack> <offset in the unpacked pack>
+// <Archipelago Item> <good>" a line; "- - <Archipelago Item> <good>" for every one), and once the slot's flag is on
+// the name is read as the good's (the pack is stored, not compressed: tools/shop_items.py writes it so). The game
+// reads a pack when the shopkeeper comes near, so a list already read keeps the item until the next time.
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <zlib.h>
+
+#include "rt.h"
+
+typedef struct { char pack[96], ap[64], good[64]; uint64_t off; uint32_t flag; } ShopName;
+static ShopName *g_names;
+static int g_n;
+static pthread_once_t g_once = PTHREAD_ONCE_INIT;
+
+// AP_Shop_<hex> of an Archipelago Item's name (Item_AP_<hex>[_...]), as a game data hash; 0: not a slot's
+static uint32_t slot_flag(const char *ap) {
+    if (strncmp(ap, "Item_AP_", 8) || strlen(ap) < 16 || !strncmp(ap, "Item_AP_00", 11)) return 0;
+    char flag[32];
+    snprintf(flag, sizeof flag, "AP_Shop_%.8s", ap + 8);
+    return (uint32_t)crc32(0, (const Bytef *)flag, (uInt)strlen(flag));
+}
+
+static void load(void) {
+    const char *dir = getenv("SAVAGEWIND_ROMFS_OVERLAY");
+    char path[1200], line[512];
+    if (!dir || !*dir) return;
+    snprintf(path, sizeof path, "%s/ap_shops.txt", dir);
+    FILE *f = fopen(path, "r");
+    if (!f) return;
+    int cap = 0;
+    while (fgets(line, sizeof line, f)) {
+        ShopName s = {0};
+        char off[32];
+        if (sscanf(line, "%95s %31s %63s %63s", s.pack, off, s.ap, s.good) != 4 || !(s.flag = slot_flag(s.ap))) continue;
+        s.off = strcmp(off, "-") ? strtoull(off, NULL, 10) : UINT64_MAX;
+        if (g_n == cap) {
+            ShopName *p = realloc(g_names, sizeof *p * (cap = cap ? cap * 2 : 1024));
+            if (!p) break;
+            g_names = p;
+        }
+        g_names[g_n++] = s;
+    }
+    fclose(f);
+    LOG("[ap] shops: %d names\n", g_n);
+}
+
+// The good an Archipelago Item of a shop slot stands for, or NULL
+const char *ap_shop_good(const char *ap) {
+    pthread_once(&g_once, load);
+    for (int i = 0; i < g_n; i++)
+        if (!strcmp(g_names[i].ap, ap)) return g_names[i].good;
+    return NULL;
+}
+
+// The saved flag of a shop slot's Archipelago Item (its hash), 0 if it isn't one
+uint32_t ap_shop_flag(const char *ap) { return slot_flag(ap); }
+
+// The overlay's file `host` was read: `n` bytes at `in` into dst. A bought slot's name reads as its good.
+void ap_shop_read(const char *host, uint64_t in, uint8_t *dst, uint64_t n) {
+    extern bool gdt_get(uint32_t hash, int32_t *out);
+    pthread_once(&g_once, load);
+    if (!g_n) return;
+    size_t hl = strlen(host);
+    for (int i = 0; i < g_n; i++) {
+        ShopName *s = &g_names[i];
+        size_t pl = strlen(s->pack);
+        if (s->off == UINT64_MAX || hl < pl || strcmp(host + hl - pl, s->pack) || (hl > pl && host[hl - pl - 1] != '/' &&
+            host[hl - pl - 1] != '\\')) continue;
+        int32_t v = 0;
+        if (!gdt_get(s->flag, &v) || !v) continue;
+        size_t an = strlen(s->ap), gn = strlen(s->good);
+        for (size_t j = 0; j < an; j++) {
+            uint64_t p = s->off + j, at = 16 + p / 8 * 9 + 1 + p % 8;  // (Yaz0, stored: a flag byte every 8)
+            if (at >= in && at < in + n) dst[at - in] = j < gn ? (uint8_t)s->good[j] : 0;
+        }
+    }
+}
