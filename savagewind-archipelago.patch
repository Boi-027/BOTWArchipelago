+
+// "!demo n": the game's item-get scene for item n, wherever Link is: raise AP_Q<n> and AP_Pending and have the runtime
+// start the overlay's event Archipelago<AP_Dispatch> (runtime/ap_event.c; botw_ap tools/give_trigger.py), which sets
+// AP_Done once the scene is over. The flags aren't saved, so a load in between clears them all: raised again. 1:
+// delivered; 0: not yet (again next tick); -1: give it directly (the item's next actions) - the overlay's event isn't
+// in this game's files, or this game version has no way to start it.
+bool g_demo_raised;
+double g_demo_asked;
+int demo(const char *n) {
+    int32_t pending, done = 0, any;
+    if (!ap_event_available()) return -1;
+    if (!gdt_get(crc("AP_Pending"), &pending)) return gdt_get(crc("MaxHartValue"), &any) ? -1 : 0;
+    gdt_get(crc("AP_Done"), &done);
+    if (g_demo_raised && done) {
+        gdt_change(crc("AP_Done"), 0, true);
+        g_demo_raised = false;
+        return 1;
+    }
+    if (!pending) {
+        gdt_change(crc("AP_Done"), 0, true);
+        gdt_change(crc(std::string("AP_Q") + n), 1, true);
+        gdt_change(crc("AP_Pending"), 1, true);
+        g_demo_raised = true;
+    } else if (now_s() - g_demo_asked < 5 || framepace_in_event()) {
+        return 0;  // (started, or a scene / talk is on: give it time)
+    }
+    ap_event_request();  // (again after a while: a start the game took may still have been dropped)
+    g_demo_asked = now_s();
+    return 0;
+}
+
+// ---- the quest log's Archipelago Hints and Archipelago Goal (botw_ap tools/quest_log.py): their words are slots in
+// the game's loaded message files - a tag after room for `cap` characters - found once in its memory and written in
+// front of the tag when the text changes. Same tags and caps as quest_log.py's SLOTS.
+struct QuestSlot { const char *tag; size_t cap; std::vector<uint64_t> at; std::string last; };
+QuestSlot g_qslots[] = {{"<APQ:HINTS>", 1200, {}, ""}, {"<APQ:GOAL>", 700, {}, ""}, {"<APQ:LOC>", 48, {}, ""}};
+double g_qscan_at = -1e9;
+int g_qscans;
+
+std::u16string u16(const std::string &s) {
+    int n = MultiByteToWideChar(CP_UTF8, 0, s.data(), (int)s.size(), nullptr, 0);
+    std::u16string w(n, u'\0');
+    if (n) MultiByteToWideChar(CP_UTF8, 0, s.data(), (int)s.size(), (wchar_t *)w.data(), n);
+    return w;
+}
+
+// Every place a tag is in the game's memory (the message files, and the packs they came in)
+size_t quest_find_in(const void *p, size_t n, void *ctx) {
+    uint64_t base = *(uint64_t *)ctx;
+    for (auto &q : g_qslots) {
+        std::u16string t = u16(q.tag);
+        const char *b = (const char *)p, *e = b + n, *tb = (const char *)t.data();
+        size_t tn = t.size() * 2;
+        for (const char *c = b; c + tn <= e && (c = (const char *)memchr(c, tb[0], (size_t)(e - c) - tn + 1)); c++)
+            if (!memcmp(c, tb, tn) && q.at.size() < 8 && base + (uint64_t)(c - b) >= GUEST_LO + q.cap * 2)
+                q.at.push_back(base + (uint64_t)(c - b));
+    }
+    return 0;
+}
+void quest_scan() {
+    for (auto &q : g_qslots) q.at.clear(), q.last.clear();
+    MEMORY_BASIC_INFORMATION m;
+    for (uint64_t a = GUEST_LO; a < GUEST_HI && VirtualQuery((void *)(uintptr_t)a, &m, sizeof m);
+         a = (uint64_t)(uintptr_t)m.BaseAddress + m.RegionSize) {
+        if (m.State != MEM_COMMIT || !(m.Protect & (PAGE_READWRITE | PAGE_READONLY)) || (m.Protect & PAGE_GUARD)) continue;
+        uint64_t base = (uint64_t)(uintptr_t)m.BaseAddress;
+        size_t ret;
+        ms_guarded(m.BaseAddress, m.RegionSize, quest_find_in, &base, &ret);
+    }
+    LOG("[ap] quest log: %zu, %zu, %zu text slots found\n", g_qslots[0].at.size(), g_qslots[1].at.size(),
+        g_qslots[2].at.size());
+}
+
+// Words wrapped to the quest page's width (about 44 characters, 11 lines at most); later lines indented. The
+// game's font has no '#': "No." instead.
+const int QUEST_LINES = 11;
+std::string wrap(const std::string &text, size_t width = 42, const char *indent = "   ") {
+    std::string s, out;
+    for (char c : text) s += c == '#' ? std::string("No.") : std::string(1, c);
+    size_t col = 0;
+    for (size_t i = 0; i < s.size();) {
+        size_t j = s.find(' ', i);
+        std::string w = s.substr(i, j == std::string::npos ? std::string::npos : j - i);
+        i = j == std::string::npos ? s.size() : j + 1;
+        if (col && col + 1 + w.size() > width) out += "\n" + std::string(indent), col = strlen(indent);
+        else if (col) out += ' ', col++;
+        out += w, col += w.size();
+    }
+    return out;
+}
+
+std::string loc_name(int64_t loc, int finder) {
+    auto g = g_loc_names.find(g_player_games[finder]);
+    if (g != g_loc_names.end() && g->second.count(loc)) return g->second[loc];
+    return "location " + std::to_string(loc);
+}
+
+std::string hints_text() {
+    std::vector<std::string> lines;
+    for (auto it = g_hints.rbegin(); it != g_hints.rend(); ++it) {  // (newest first)
+        const json &h = *it;
+        int to = h.value("receiving_player", -1), from = h.value("finding_player", -1);
+        std::string item = item_name(h.value("item", (int64_t)0), to), loc = loc_name(h.value("location", (int64_t)0), from);
+        std::string s = (to == g_slot ? item : player(to) + "'s " + item) + ": " +
+                        (from == g_slot ? loc : player(from) + "'s " + loc);
+        if (h.value("found", false)) s += " (found)";
+        lines.push_back(wrap(s));
+    }
+    if (lines.empty()) return "No hints yet. The hints you get in the\nmultiworld (bought, or given by other\nplayers) are listed here, newest first.";
+    std::string out = "Hints, newest first (" + std::to_string(lines.size()) + "):";
+    int used = 1;
+    size_t shown = 0;
+    for (size_t i = 0; i < lines.size(); i++) {
+        int n = 1 + (int)std::count(lines[i].begin(), lines[i].end(), '\n');
+        bool last = i + 1 == lines.size();
+        if (used + n + (last ? 0 : 1) > QUEST_LINES || out.size() + lines[i].size() + 8 > g_qslots[0].cap - 40) break;
+        out += "\n" + std::to_string(i + 1) + ". " + lines[i], used += n, shown++;
+    }
+    if (shown < lines.size()) out += "\n(" + std::to_string(lines.size() - shown) + " older not shown)";
+    return out;
+}
+
+std::string goal_text() {
+    json want = g_slot_data.value("champion_powers", json::array());
+    int need = g_slot_data.value("required_champion_powers", 4);
+    bool need_sword = g_slot_data.value("goal_needs_master_sword", false);
+    int64_t sword_id = g_slot_data.value("master_sword", (int64_t)-1);
+    std::set<int64_t> have;
+    bool sword = false;
+    for (auto &it : g_items) {
+        int64_t id = it.value("item", (int64_t)0);
+        if (std::find(want.begin(), want.end(), id) != want.end()) have.insert(id);
+        sword |= id == sword_id;
+    }
+    std::string s = "Defeat Calamity Ganon at Hyrule Castle.\n\nChampion powers: " + std::to_string(have.size()) +
+                    " of " + std::to_string(need) + (have.size() >= (size_t)need ? " - done" : "");
+    for (auto &w : want) {
+        int64_t id = w.get<int64_t>();
+        s += "\n   " + std::string(have.count(id) ? "[x] " : "[  ] ") + item_name(id, g_slot);
+    }
+    if (need_sword) s += "\nMaster Sword: " + std::string(sword ? "found - done" : "not found yet");
+    s += "\nChecks: " + std::to_string(g_checked.size()) + " of " + std::to_string(g_checked.size() + g_missing.size());
+    if (have.size() >= (size_t)need && (sword || !need_sword)) s += "\n\nYou are ready to face Ganon.";
+    return s;
+}
+
+// Keep the quests shown and their words current (connected, in the world)
+void quest_tick() {
+    // (botw_ap tools/give_trigger.py QUESTS: names the game's quest list knows that none of its quests use)
+    static const char *const flags[] = {"PrezentationOkamura_Activated", "TurnTestQuest_Activated"};
+    for (const char *f : flags) {
+        int32_t on = 0, want = 0;
+        if (!gdt_get(crc(f), &on) || on) continue;
+        std::string w = std::string("AP_Want_") + f;
+        if (gdt_get(crc(w), &want) && !want) gdt_change(crc(w), 1, true);
+        g_env_sync = true;  // (shown through the overlay's event, as the traps' flags are)
+    }
+    if (g_qslots[0].at.empty() && g_qslots[1].at.empty() && g_qscans < 3 && now_s() - g_qscan_at > 30)
+        g_qscan_at = now_s(), g_qscans++, quest_scan();
+    std::string text[] = {hints_text(), goal_text(), "Multiworld: " + g_slot_name};
+    for (int k = 0; k < 3; k++) {
+        QuestSlot &q = g_qslots[k];
+        if (text[k] == q.last) continue;
+        std::u16string w = u16(text[k]), tag = u16(q.tag);
+        if (w.size() > q.cap - 1) w.resize(q.cap - 1);
+        for (uint64_t at : q.at) {
+            if (memcmp((void *)(uintptr_t)at, tag.data(), tag.size() * 2)) continue;  // (gone: a reboot moved it)
+            char16_t *dst = (char16_t *)(uintptr_t)(at - q.cap * 2);
+            memcpy(dst, w.data(), w.size() * 2);
+            dst[w.size()] = 0;
+        }
+        q.last = text[k];
+    }
+}
+
+// ---- the game side, twice a second (under g_lock)
+void game_tick() {
+    if (g_weather_restore >= 0 && now_s() > g_weather_until) g_settings.weather = g_weather_restore, g_weather_restore = -1;
+    for (auto it = g_prohibit_until.begin(); it != g_prohibit_until.end();)
+        if (now_s() > it->second && gdt_change(crc(it->first), 0, true)) {
+            g_env_sync |= !it->first.compare(0, 8, "AP_Want_");
+            it = g_prohibit_until.erase(it);
+        } else ++it;
+    // the environment and enemy traps' flags as their wants, by the overlay's event (one scene at a time: not while an
+    // item's is on, and the items wait for it)
+    if ((g_env_sync || g_env_syncing) && in_world() && (g_env_syncing || !g_demo_raised)) {
+        if (!g_env_syncing) g_env_sync = false, g_env_syncing = true;  // (a want changed meanwhile: again after)
+        if (demo(SYNC_Q) == 0) return;  // (-1: no event in these files; the wants alone do nothing)
+        g_env_syncing = false;
+    }
+    if (!g_connected) return;
+    if (!in_world()) { g_rupees_seen = -1; return; }  // (a load sets the wallet from the save: not a RingLink change)
+    quest_tick();
+    // checks
+    std::vector<int64_t> found;
+    json counters = g_slot_data.value("counters", json::object());  // (id -> [name, n]: a count the game keeps, >= n)
+    for (int64_t id : g_missing) {
+        int32_t v = 0;
+        std::string key = std::to_string(id);
+        if (counters.contains(key)) {
+            const json &c = counters[key];
+            if (gdt_get(crc(c[0].get<std::string>()), &v) && v >= c[1].get<int>()) found.push_back(id);
+        } else if (gdt_get((uint32_t)(id - LOC_BASE), &v) && v) found.push_back(id);
+    }
+    if (!found.empty()) {
+        send(json::array({{{"cmd", "LocationChecks"}, {"locations", found}}}));
+        for (int64_t id : found) g_missing.erase(id), g_checked.insert(id);
+        set_status_connected();
+    }
+    // region lock: the slot's choice, in the save (runtime/ap_region.c keeps Link out of locked regions while it is on)
+    int32_t lock = 0;
+    bool want_lock = g_slot_data.value("region_lock", false);
+    if (gdt_get(crc("AP_RegionLock"), &lock) && (lock != 0) != want_lock) gdt_change(crc("AP_RegionLock"), want_lock, true);
+    // the goal
+    int32_t ganon = 0, beast = 0;
+    if (!g_goal_sent && ((gdt_get(crc("GanonQuest_Finished"), &ganon) && ganon) ||
+                         (gdt_get(crc("Defeated_Enemy_GanonBeast_Num"), &beast) && beast > 0))) {
+        std::set<int64_t> powers;  // (each champion power once: the second copy of one is its "+")
+        bool sword = false;
+        json want = g_slot_data.value("champion_powers", json::array());
+        for (auto &it : g_items) {
+            int64_t id = it.value("item", (int64_t)0);
+            if (std::find(want.begin(), want.end(), id) != want.end()) powers.insert(id);
+            sword |= id == g_slot_data.value("master_sword", (int64_t)-1);
+        }
+        int need = g_slot_data.value("required_champion_powers", 4);
+        if ((int)powers.size() >= need && (sword || !g_slot_data.value("goal_needs_master_sword", false))) {
+            send(json::array({{{"cmd", "StatusUpdate"}, {"status", 30}}}));
+            g_goal_sent = true;
+            notify({{"Goal complete!", GOLD}});
+        }
+    }
+    // items
+    json actions = g_slot_data.value("actions", json::object());
+    while (g_given < (int)g_items.size()) {
+        const json &it = g_items[g_given];
+        int64_t id = it.value("item", (int64_t)0);
+        std::string key = std::to_string(id);
+        json steps = actions.contains(key) ? actions[key] : json::array();
+        int copy = 0;  // (which copy of this item this is: "@<k> <action>" is only for the k-th, progressive items)
+        for (int i = 0; i <= g_given; i++) copy += g_items[i].value("item", (int64_t)0) == id;
+        for (; g_step < (int)steps.size(); g_step++, save_state()) {
+            std::string s = steps[g_step].get<std::string>();
+            if (s[0] == '@') {
+                size_t sp = s.find(' ');
+                if (sp == std::string::npos || atoi(s.c_str() + 1) != copy) continue;
+                s = s.substr(sp + 1);
+            }
+            char w0[64] = "", w1[96] = "", w2[32] = "";
+            sscanf(s.c_str(), "%63s %95s %31s", w0, w1, w2);
+            if (!strcmp(w0, "!demo") || !strcmp(w0, "!msg")) {
+                if (g_env_sync && !g_demo_raised) return;  // (a sync waits: it goes first, at the next tick)
+                int r = demo(w1);
+                if (r == 0) return;
+                // (the scene gave it: the direct gives after it are skipped; "!msg": only its banner, the rest follows)
+                if (r == 1 && !strcmp(w0, "!demo")) g_step = (int)steps.size() - 1;
+            } else if (!strcmp(w0, "!trap")) {
+                trap(w1);
+                if (g_tags.count("TrapLink"))
+                    send(json::array({{{"cmd", "Bounce"}, {"tags", {"TrapLink"}},
+                                       {"data", {{"time", (double)time(nullptr)}, {"source", g_slot_name}, {"trap_name", item_name(id, g_slot)}}}}}));
+            } else if (w0[0] == '!') {
+                bool ok = gdt_change(crc(w1), atof(w2), !strcmp(w0, "!set"));
+                if (!ok) return;  // (the game data isn't there yet: again next tick, from this step)
+                // (rupees an item gives aren't the player's own: not for RingLink)
+                if (!strcmp(w1, "CurrentRupee") && g_rupees_seen >= 0) g_rupees_seen += atoi(w2);
+            } else {
+                bool key_item = !strcmp(w0, "givekey");
+                int r = items_give_actor(key_item ? w1 : w0, atoi(key_item ? w2 : w1));
+                if (r == 0) return;  // (the queue is full: again next tick)
+            }
+        }
+        g_given++, g_step = 0;
+        save_state();
+    }
+    // DeathLink: Link's own deaths
+    int deaths = rt_link_deaths();
+    if (g_deaths_seen >= 0 && deaths > g_deaths_seen && g_tags.count("DeathLink") && now_s() - g_killed_at > 15) {
+        send(json::array({{{"cmd", "Bounce"}, {"tags", {"DeathLink"}},
+                           {"data", {{"time", (double)time(nullptr)}, {"source", g_slot_name}, {"cause", g_slot_name + " fell in Hyrule."}}}}}));
+        notify({{"DeathLink: ", RED}, {"you died, and took everyone with you", CREAM}});
+    }
+    if (deaths != g_deaths_seen) g_rupees_seen = -1;  // (a death: the game reloads, the wallet with it)
+    g_deaths_seen = deaths;
+    // RingLink: the wallet's changes that weren't ours
+    int32_t rupees = 0;
+    if (g_tags.count("RingLink") && gdt_get(crc("CurrentRupee"), &rupees)) {
+        if (g_rupees_seen >= 0 && rupees != g_rupees_seen)
+            send(json::array({{{"cmd", "Bounce"}, {"tags", {"RingLink"}},
+                               {"data", {{"time", (double)time(nullptr)}, {"source", g_slot}, {"amount", rupees - g_rupees_seen}}}}}));
+        g_rupees_seen = rupees;
+    }
+    // the links switched in the Options while connected
+    std::set<std::string> want;
+    for (auto &t : tags_now()) want.insert(t.get<std::string>());
+    if (want != g_tags) {
+        g_tags = want;
+        send(json::array({{{"cmd", "ConnectUpdate"}, {"tags", tags_now()}}}));
+    }
+}
+
+// "host:port", "ws://host:port", "wss://host" -> host, port (38281 when none), tls (-1: try wss, then ws)
+void parse_server(const std::string &s, std::wstring &host, int &port, int &tls) {
+    std::string h = s;
+    tls = -1;
+    if (!h.compare(0, 6, "wss://")) h = h.substr(6), tls = 1;
+    else if (!h.compare(0, 5, "ws://")) h = h.substr(5), tls = 0;
+    port = 38281;
+    size_t colon = h.rfind(':');
+    if (colon != std::string::npos) port = atoi(h.c_str() + colon + 1), h = h.substr(0, colon);
+    host.assign(h.begin(), h.end());
+}
+
+void net_thread() {
+    unsigned seen = 0;
+    for (;;) {
+        unsigned want = ap_connects();
+        if (want == seen || !g_settings.ap_server[0]) { std::this_thread::sleep_for(std::chrono::milliseconds(250)); continue; }
+        seen = want;
+        std::wstring host;
+        int port, tls;
+        parse_server(g_settings.ap_server, host, port, tls);
+        char buf[200];
+        snprintf(buf, sizeof buf, "Connecting to %s...", g_settings.ap_server);
+        ap_set_status(buf);
+        Ws *ws = new Ws;
+        bool ok = (tls != 0 && ws->open(host, port, true)) || (tls != 1 && ws->open(host, port, false));
+        if (!ok) {
+            delete ws;
+            snprintf(buf, sizeof buf, "Can't reach %s", g_settings.ap_server);
+            ap_set_status(buf);
+            continue;
+        }
+        { std::lock_guard<std::mutex> l(g_lock); g_ws = ws; g_connected = false; }
+        std::string msg;
+        while (ws->recv(msg)) {
+            json packets = json::parse(msg, nullptr, false);
+            if (!packets.is_array()) continue;
+            std::lock_guard<std::mutex> l(g_lock);
+            for (auto &p : packets) {
+                try { on_packet(p); } catch (const std::exception &e) { LOG("[ap] packet: %s\n", e.what()); }
+            }
+            if (ap_connects() != seen) break;  // (Connect again: a new connection)
+        }
+        {
+            std::lock_guard<std::mutex> l(g_lock);
+            g_ws = nullptr;
+            if (g_connected) notify({{"Disconnected from the multiworld", RED}});
+            g_connected = false;
+        }
+        ws->close();
+        delete ws;
+        ap_set_status("Disconnected");
+    }
+}
+
+void tick_thread() {
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(500));
+        std::lock_guard<std::mutex> l(g_lock);
+        try { game_tick(); } catch (const std::exception &e) { LOG("[ap] tick: %s\n", e.what()); }
+    }
+}
+
+}  // namespace
+
+// Every frame (menu.mm's menu_draws): starts the client once; true while a notification is up, so the overlay draws
+bool ap_overlay_active(void) {
+    static std::once_flag started;
+    std::call_once(started, [] { std::thread(net_thread).detach(); std::thread(tick_thread).detach(); });
+    std::lock_guard<std::mutex> l(g_note_lock);
+    return !g_notes.empty();
+}
+
+// The notifications, bottom left, in the style of the game's menus: a dark band between gold rules, a Sheikah-blue
+// mark, cream text. Called every frame from menu.mm (outside the menus); the first call starts the client.
+void ap_overlay_draw(ImGuiIO &io, float scale) {
+    // region lock's fog (runtime/ap_region.c): a pale haze over the world, thicker below, white when it turns Link back
+    float fog = ap_region_fog();
+    if (fog > 0.004f) {
+        ImDrawList *bg = ImGui::GetBackgroundDrawList();
+        float a = fminf(1.f, fog * 1.08f);
+        ImU32 top = IM_COL32(222, 226, 226, (int)(255 * a * 0.82f)), low = IM_COL32(232, 235, 233, (int)(255 * a));
+        bg->AddRectFilledMultiColor(ImVec2(0, 0), io.DisplaySize, top, top, low, low);
+    }
+    std::lock_guard<std::mutex> l(g_note_lock);
+    double t = now_s();
+    while (!g_notes.empty() && t - g_notes.front().born > 7.3) g_notes.pop_front();
+    ImDrawList *dl = ImGui::GetForegroundDrawList();
+    float h = 40 * scale, gap = 7 * scale, pad = 16 * scale;
+    float y = io.DisplaySize.y - io.DisplaySize.y * 0.14f - g_notes.size() * (h + gap);
+    for (const Note &n : g_notes) {
+        double age = t - n.born;
+        float in = (float)fmin(1.0, age / 0.22), out = age > 7.0 ? (float)fmin(1.0, (age - 7.0) / 0.3) : 0.f;
+        float w = 34 * scale + pad;
+        for (const Seg &s : n.segs) w += ImGui::CalcTextSize(s.text.c_str()).x;
+        float slide = 1 - (1 - in) * (1 - in) * (1 - in);
+        float x = 24 * scale - w * (1 - slide) - w * out;
+        dl->AddRectFilled(ImVec2(x, y), ImVec2(x + w, y + h), IM_COL32(18, 18, 18, 225));
+        dl->AddLine(ImVec2(x, y), ImVec2(x + w, y), IM_COL32(181, 154, 91, 255), scale);
+        dl->AddLine(ImVec2(x, y + h - 1), ImVec2(x + w, y + h - 1), IM_COL32(181, 154, 91, 255), scale);
+        dl->AddLine(ImVec2(x + 4 * scale, y + 3 * scale), ImVec2(x + 4 * scale, y + h - 3 * scale), IM_COL32(79, 211, 232, 255), 2 * scale);
+        float cy = y + h / 2, cx = x + 18 * scale, r = 6 * scale;
+        dl->AddQuadFilled(ImVec2(cx, cy - r), ImVec2(cx + r, cy), ImVec2(cx, cy + r), ImVec2(cx - r, cy), IM_COL32(79, 211, 232, 255));
+        float tx = x + 34 * scale, ty = cy - ImGui::GetTextLineHeight() / 2;
+        for (const Seg &s : n.segs) {
+            dl->AddText(ImVec2(tx, ty), s.col, s.text.c_str());
+            tx += ImGui::CalcTextSize(s.text.c_str()).x;
+        }
+        y += h + gap;
+    }
+}
