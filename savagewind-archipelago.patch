diff --git a/runtime/control_ap.c b/runtime/control_ap.c
new file mode 100644
index 0000000..2c7975f
--- /dev/null
+++ b/runtime/control_ap.c
@@ -0,0 +1,147 @@
+// Archipelago: what Options > Archipelago (runtime/ui/game_options.mm) asks for, for the multiworld client (botw_ap)
+// that polls this console. The client does the networking; the game keeps the settings (savagewind.ini ap_*), counts
+// the Connect presses and shows the status the client sends back.
+//   ap                   the server, slot, password, the links and the Connect count
+//   apstatus <text>      the line Options > Archipelago shows under Connect
+//   life [kill]          Link's life in quarter hearts and his deaths so far (DeathLink); kill: the next store is 0,
+//                        and the life is set to 0 now when its place is known (runtime/assists.c)
+//   apconnect            presses Options > Archipelago's Connect (developer mode: for tests)
+//   apscene              starts the overlay's item scene event now (developer mode: runtime/ap_event.c)
+//   aptrap <kind>        a trap's effect now, as one received (developer mode: runtime/ui/ap_client.mm)
+//   gdt <flag> [value]   a game flag's value (bool, s32 or f32: runtime/gdt_flags.c); value: set it first
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <zlib.h>
+
+#include "control.h"
+#include "settings.h"
+
+uint64_t rt_link_life_addr(void);  // runtime/assists.c
+int rt_link_deaths(void);
+void rt_link_kill(void);
+bool gdt_get(uint32_t hash, int32_t *out);  // runtime/gdt_flags.c
+bool gdt_change(uint32_t hash, double d, bool set);
+int gdt_copies(uint32_t hash, uint64_t *objs, int max);
+
+static atomic_uint g_connects, g_status_seq;
+static char g_status[160] = "Not connected";
+static pthread_mutex_t g_lock = PTHREAD_MUTEX_INITIALIZER;
+
+void ap_request_connect(void) { g_connects++; }
+unsigned ap_connects(void) { return g_connects; }  // (the native client: runtime/ui/ap_client.mm)
+unsigned ap_status_seq(void) { return g_status_seq; }  // (changes with every apstatus)
+
+// (a copy: the client may change it at any time)
+const char *ap_status(void) {
+    static char out[sizeof g_status];
+    pthread_mutex_lock(&g_lock);
+    memcpy(out, g_status, sizeof out);
+    pthread_mutex_unlock(&g_lock);
+    return out;
+}
+
+static void cmd_ap(int argc, char **argv, ControlReply *r) {
+    (void)argc, (void)argv;
+    control_field_str(r, "server", g_settings.ap_server);
+    control_field_str(r, "slot", g_settings.ap_slot);
+    control_field_str(r, "password", g_settings.ap_password);
+    control_field_bool(r, "deathlink", g_settings.ap_deathlink);
+    control_field_bool(r, "traplink", g_settings.ap_traplink);
+    control_field_bool(r, "ringlink", g_settings.ap_ringlink);
+    control_field_int(r, "connects", g_connects);
+    extern void ap_client_state(char *buf, size_t n);  // runtime/ui/ap_client.mm
+    char state[512];
+    ap_client_state(state, sizeof state);
+    control_field_str(r, "client", state);
+}
+
+void ap_set_status(const char *text) {
+    pthread_mutex_lock(&g_lock);
+    snprintf(g_status, sizeof g_status, "%s", text);
+    pthread_mutex_unlock(&g_lock);
+    g_status_seq++;
+}
+
+static void cmd_apstatus(int argc, char **argv, ControlReply *r) {
+    char text[sizeof g_status] = "";
+    size_t n = 0;
+    for (int i = 1; i < argc && n < sizeof text - 1; i++)
+        n += (size_t)snprintf(text + n, sizeof text - n, "%s%s", i > 1 ? " " : "", argv[i]);
+    pthread_mutex_lock(&g_lock);
+    memcpy(g_status, text, sizeof g_status);
+    pthread_mutex_unlock(&g_lock);
+    g_status_seq++;
+    control_field_str(r, "status", text);
+}
+
+static void cmd_life(int argc, char **argv, ControlReply *r) {
+    if (argc > 2 || (argc == 2 && strcmp(argv[1], "kill"))) { control_fail(r, "Usage: life [kill]"); return; }
+    uint64_t a = rt_link_life_addr();
+    if (argc == 2) {
+        rt_link_kill();
+        control_field_bool(r, "killed", true);
+    }
+    if (a) control_field_int(r, "life", *(volatile int32_t *)(uintptr_t)a);
+    control_field_int(r, "deaths", rt_link_deaths());
+}
+
+static void cmd_apconnect(int argc, char **argv, ControlReply *r) {
+    (void)argc, (void)argv;
+    ap_request_connect();
+    control_field_int(r, "connects", g_connects);
+}
+
+void ap_event_request(void);  // runtime/ap_event.c
+bool ap_event_available(void);
+static void cmd_apscene(int argc, char **argv, ControlReply *r) {
+    (void)argc, (void)argv;
+    if (!ap_event_available()) { control_fail(r, "This game version has no event start found"); return; }
+    ap_event_request();
+    control_field_bool(r, "requested", true);
+}
+
+static void cmd_gdt(int argc, char **argv, ControlReply *r) {
+    if (argc < 2 || argc > 3) { control_fail(r, "Usage: gdt <flag> [value]"); return; }
+    uint32_t h = (uint32_t)crc32(0, (const unsigned char *)argv[1], (unsigned)strlen(argv[1]));
+    if (argc == 3 && !gdt_change(h, atof(argv[2]), true)) { control_fail(r, "No such flag (or not in the world)"); return; }
+    int32_t v;
+    if (!gdt_get(h, &v)) { control_fail(r, "No such flag (or not in the world)"); return; }
+    control_field_int(r, "value", v);
+    uint64_t o[8];
+    int n = gdt_copies(h, o, 8);
+    control_field_int(r, "copies", n);
+    char k[16], val[64];
+    for (int i = 0; i < n && i < 8; i++) {
+        snprintf(k, sizeof k, "copy%d", i);
+        snprintf(val, sizeof val, "0x%llx: %08x %08x", (unsigned long long)o[i],
+                 *(volatile uint32_t *)(uintptr_t)(o[i] + 8), *(volatile uint32_t *)(uintptr_t)(o[i] + 0x18));
+        control_field_str(r, k, val);
+    }
+}
+
+static void cmd_aptrap(int argc, char **argv, ControlReply *r) {
+    extern void ap_trap_now(const char *kind);  // runtime/ui/ap_client.mm
+    if (argc != 2) { control_fail(r, "Usage: aptrap <kind>"); return; }
+    ap_trap_now(argv[1]);
+    control_field_str(r, "trap", argv[1]);
+}
+
+// (runtime/control_game.c: ap and apstatus for every player, life only in developer mode - kill writes the game)
+void control_ap_init(bool dev) {
+    static const ControlCmd player[] = {
+        {"ap", "", "Archipelago: the server, slot, password and links set in Options", cmd_ap, CONTROL_PLAYER},
+        {"apstatus", "<text>", "Archipelago: the status line Options > Archipelago shows", cmd_apstatus, CONTROL_PLAYER},
+    };
+    static const ControlCmd devc[] = {
+        {"life", "[kill]", "Link's life (quarter hearts) and deaths; kill: DeathLink", cmd_life, 0},
+        {"gdt", "<flag> [value]", "a game flag's value; value: set it first", cmd_gdt, 0},
+        {"apconnect", "", "Archipelago: press Connect", cmd_apconnect, 0},
+        {"apscene", "", "Archipelago: start the item scene event", cmd_apscene, 0},
+        {"aptrap", "<kind>", "Archipelago: a trap's effect (heat, thief, bokoblins...)", cmd_aptrap, 0},
+    };
+    control_register(player, 2);
+    if (dev) control_register(devc, 5);
+}
