+void chat_draw(ImGuiIO &io, float scale) {  // (g_note_lock held)
+    static char buf[256];
+    if (g_chat_appearing.exchange(false)) buf[0] = 0, g_chat_scroll = 0;
+    float fs = 28 * scale, lh = fs * 1.32f, pad = 18 * scale;
+    float w = fminf(io.DisplaySize.x * .52f, 1000 * scale), x = 24 * scale;
+    int rows = (int)fmaxf(4.f, io.DisplaySize.y * .40f / lh);
+    float input_y = io.DisplaySize.y * .86f, top = input_y - rows * lh - pad * 1.4f, log_top = top + pad * .7f;
+    ImDrawList *dl = ImGui::GetForegroundDrawList();
+    draw_panel(dl, ImVec2(x, top), ImVec2(x + w, input_y + lh + pad * .7f), scale);
+    // the log, newest at the bottom: the wheel, PgUp / PgDn and Up / Down move it
+    int n = (int)g_history.size(), most = n > rows ? n - rows : 0;
+    g_chat_scroll += io.MouseWheel * 3;
+    if (ImGui::IsKeyPressed(ImGuiKey_PageUp)) g_chat_scroll += rows - 1;
+    if (ImGui::IsKeyPressed(ImGuiKey_PageDown)) g_chat_scroll -= rows - 1;
+    if (ImGui::IsKeyPressed(ImGuiKey_UpArrow)) g_chat_scroll += 1;
+    if (ImGui::IsKeyPressed(ImGuiKey_DownArrow)) g_chat_scroll -= 1;
+    g_chat_scroll = fmaxf(0.f, fminf(g_chat_scroll, (float)most));
+    int last = n - (int)g_chat_scroll, first = last - rows < 0 ? 0 : last - rows;
+    float ly = input_y - pad * .45f - (last - first) * lh;
+    dl->PushClipRect(ImVec2(x, log_top), ImVec2(x + w, input_y - pad * .3f), true);
+    for (int i = first; i < last; i++, ly += lh) {
+        draw_mark(dl, x + pad + 5 * scale, ly + lh * .5f, 4.5f * scale, .8f);
+        draw_segs(dl, ImVec2(x + pad + 18 * scale, ly + (lh - fs) * .5f), fs, g_history[i].segs, 1);
+    }
+    dl->PopClipRect();
+    if (most > 0) {  // (where in the log: a thin bar at the right)
+        float span = input_y - pad * .9f - log_top, bh = span * rows / n, by = log_top + (span - bh) * (1 - g_chat_scroll / most);
+        dl->AddRectFilled(ImVec2(x + w - 6 * scale, by), ImVec2(x + w - 3 * scale, by + bh), IM_COL32(236, 232, 214, 110), 2 * scale);
+    }
+    // the line to type in: an invisible ImGui field over the band's last row, its text in the game's font
+    draw_rule(dl, x + pad, x + w - pad, input_y - pad * .15f, scale);
+    ImGui::SetNextWindowPos(ImVec2(x + pad, input_y), ImGuiCond_Always);
+    ImGui::SetNextWindowSize(ImVec2(w - pad * 2, lh + 4 * scale), ImGuiCond_Always);
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0, 0));
+    ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(0, (lh - fs) * .5f));
+    ImGui::PushStyleColor(ImGuiCol_FrameBg, IM_COL32(0, 0, 0, 0));
+    ImGui::PushStyleColor(ImGuiCol_Text, IM_COL32(245, 246, 232, 255));
+    ImGui::Begin("##apchat", NULL, ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoBackground | ImGuiWindowFlags_NoMove |
+                                       ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoNav);
+    ImFont *f = g_game_font ? g_game_font : ImGui::GetFont();
+    ImGui::PushFont(f);
+    ImGui::SetWindowFontScale(fs / (f->FontSize * io.FontGlobalScale));  // (the frame scales fonts too: the same size as the log)
+    ImGui::SetNextItemWidth(-1);
+    ImGui::SetKeyboardFocusHere();
+    if (ImGui::InputText("##say", buf, sizeof buf, ImGuiInputTextFlags_EnterReturnsTrue)) {
+        std::string text = buf;
+        while (!text.empty() && text.back() == ' ') text.pop_back();
+        if (!text.empty()) say(text);
+        buf[0] = 0;
+        g_chat_open = false;
+    }
+    ImGui::PopFont();
+    ImGui::End();
+    ImGui::PopStyleColor(2);
+    ImGui::PopStyleVar(2);
+}
