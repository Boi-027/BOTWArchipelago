+// The game's own font (menu.mm loads its glyphs from the player's files) where it has every character of the text
+ImFont *g_game_font;
+ImFont *font_for(const std::string &s) {
+    if (!g_game_font) return ImGui::GetFont();
+    for (const char *p = s.c_str(); *p;) {
+        unsigned c;
+        int n = ImTextCharFromUtf8(&c, p, nullptr);
+        if (!n) break;
+        p += n;
+        if (!g_game_font->FindGlyphNoFallback((ImWchar)c)) return ImGui::GetFont();
+    }
+    return g_game_font;
+}
+float segs_width(const std::vector<Seg> &segs, float fs) {
+    float w = 0;
+    for (const Seg &s : segs) w += font_for(s.text)->CalcTextSizeA(fs, FLT_MAX, 0, s.text.c_str()).x;
+    return w;
+}
+// a line as the game writes its words: light text with a soft shadow under it
+void draw_segs(ImDrawList *dl, ImVec2 at, float fs, const std::vector<Seg> &segs, float alpha) {
+    for (const Seg &s : segs) {
+        ImFont *f = font_for(s.text);
+        ImU32 col = (s.col & 0x00ffffff) | ((ImU32)(((s.col >> 24) & 0xff) * alpha) << 24);
+        dl->AddText(f, fs, ImVec2(at.x + fs * .06f, at.y + fs * .08f), IM_COL32(0, 0, 0, (int)(150 * alpha)), s.text.c_str());
+        dl->AddText(f, fs, at, col, s.text.c_str());
+        at.x += f->CalcTextSizeA(fs, FLT_MAX, 0, s.text.c_str()).x;
+    }
+}
+// a band like the game's pick-up and quest banners: dark, fading out to the right, a thin light rule above and below
+void draw_band(ImDrawList *dl, ImVec2 a, ImVec2 b, float fade, float alpha) {
+    ImU32 dark = IM_COL32(0, 0, 0, (int)(165 * alpha)), clear = IM_COL32(0, 0, 0, 0);
+    ImU32 rule = IM_COL32(236, 232, 214, (int)(120 * alpha)), rule0 = IM_COL32(236, 232, 214, 0);
+    dl->AddRectFilled(a, b, dark);
+    dl->AddRectFilledMultiColor(ImVec2(b.x, a.y), ImVec2(b.x + fade, b.y), dark, clear, clear, dark);
+    float t = fmaxf(1.f, (b.y - a.y) * .03f);
+    dl->AddRectFilledMultiColor(a, ImVec2(b.x + fade, a.y + t), rule, rule0, rule0, rule);
+    dl->AddRectFilledMultiColor(ImVec2(a.x, b.y - t), ImVec2(b.x + fade, b.y), rule, rule0, rule0, rule);
+}
+// a window like the game's item and info panels: rounded dark glass, a thin light bracket in each corner
+void draw_panel(ImDrawList *dl, ImVec2 a, ImVec2 b, float scale) {
+    dl->AddRectFilled(a, b, IM_COL32(12, 14, 13, 178), 9 * scale);
+    float in = 7 * scale, len = 13 * scale, t = 1.3f * scale;
+    ImU32 c = IM_COL32(214, 212, 196, 170);
+    for (int i = 0; i < 4; i++) {
+        float cx = i & 1 ? b.x - in : a.x + in, cy = i & 2 ? b.y - in : a.y + in, sx = i & 1 ? -1.f : 1.f, sy = i & 2 ? -1.f : 1.f;
+        dl->AddLine(ImVec2(cx, cy), ImVec2(cx + sx * len, cy), c, t);
+        dl->AddLine(ImVec2(cx, cy), ImVec2(cx, cy + sy * len), c, t);
+    }
+}
+// a rule as the game's panels draw one under a title: thin, light, fading out at both ends
+void draw_rule(ImDrawList *dl, float x0, float x1, float y, float scale) {
+    float m = (x0 + x1) / 2, t = fmaxf(1.f, scale);
+    ImU32 on = IM_COL32(214, 212, 196, 120), off = IM_COL32(214, 212, 196, 0);
+    dl->AddRectFilledMultiColor(ImVec2(x0, y), ImVec2(m, y + t), off, on, on, off);
+    dl->AddRectFilledMultiColor(ImVec2(m, y), ImVec2(x1, y + t), on, off, off, on);
+}
+void draw_mark(ImDrawList *dl, float cx, float cy, float r, float alpha) {  // (a small Sheikah-blue diamond)
+    dl->AddQuadFilled(ImVec2(cx, cy - r), ImVec2(cx + r, cy), ImVec2(cx, cy + r), ImVec2(cx - r, cy),
+                      IM_COL32(110, 226, 240, (int)(255 * alpha)));
+}
