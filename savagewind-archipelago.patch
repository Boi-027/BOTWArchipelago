diff --git a/runtime/gdt_flags.c b/runtime/gdt_flags.c
new file mode 100644
index 0000000..5d68a46
--- /dev/null
+++ b/runtime/gdt_flags.c
@@ -0,0 +1,164 @@
+// Game data flags by the crc32 of their name, read and written in place, for the Archipelago client
+// (runtime/ui/ap_client.mm): checks are flags going on, Heart Containers and the like are flags it raises.
+//
+// Each flag is an object on the game's heap (runtime/rupees.c has the layout): a bool flag is 0x18 bytes - +0 its class
+// (vtable, in main), +0x9 its properties, +0xb bit 0 its value (the bits above: its category), +0xc the hash; an s32 or f32 flag 0x28 bytes - +0 its class, +0x18 its value,
+// +0x1c the hash. Each class is found from a flag of that type every version has, then one pass over the heap indexes
+// every object of the three classes. A new game or a load may lay the heap out again: each use checks its object
+// first, and a mismatch rebuilds the index (at most once every few seconds).
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <zlib.h>
+
+#include "game_sites.h"
+#include "hle.h"
+#include "kernel.h"
+#include "platform.h"
+#include "rt.h"
+
+enum { T_BOOL, T_S32, T_F32, T_COUNT };
+static const uint32_t HASH_AT[T_COUNT] = {0xc, 0x1c, 0x1c};
+static const char *const PROBE[T_COUNT] = {"IsGet_Obj_HeroSoul_Zora", "MaxHartValue", "StaminaMax"};
+
+typedef struct { uint32_t hash; uint8_t type; uint64_t obj; } Ent;
+static Ent *g_idx;
+static size_t g_n;
+static uint64_t g_vt[T_COUNT];
+static time_t g_built;
+static pthread_mutex_t g_lock = PTHREAD_MUTEX_INITIALIZER;
+
+RT_ON_RESET(gdt_flags_reset) {  // (a reboot's flags are new objects)
+    pthread_mutex_lock(&g_lock);
+    free(g_idx), g_idx = NULL, g_n = 0, g_built = 0;
+    memset(g_vt, 0, sizeof g_vt);
+    pthread_mutex_unlock(&g_lock);
+}
+
+static uint32_t rd32(uint64_t a) { return *(volatile uint32_t *)(uintptr_t)a; }
+static uint64_t rd64(uint64_t a) { return *(volatile uint64_t *)(uintptr_t)a; }
+static bool in_main(uint64_t v) { return v >= 0x7000000000ull && g_site.main_end && v < g_site.main_end && !(v & 7); }
+
+// The class of type t: the object holding PROBE[t]'s hash at HASH_AT[t] with a vtable in main
+static uint64_t find_class(int t, uint64_t lo, uint64_t hi) {
+    uint32_t hash = (uint32_t)crc32(0, (const Bytef *)PROBE[t], (uInt)strlen(PROBE[t]));
+    uint64_t a, e;
+    for (uint64_t at = lo; plat_committed_range(at, hi, &a, &e); at = e)
+        for (uint64_t o = (a + 7) & ~7ull; o + HASH_AT[t] + 4 <= e; o += 8)  // (objects are 8-aligned)
+            if (rd32(o + HASH_AT[t]) == hash && in_main(rd64(o))) return rd64(o);
+    return 0;
+}
+
+static int cmp_ent(const void *x, const void *y) {
+    uint32_t a = ((const Ent *)x)->hash, b = ((const Ent *)y)->hash;
+    return a < b ? -1 : a > b;
+}
+
+// (under g_lock) false: no heap yet, or a class wasn't found (the game isn't far enough along)
+static bool build(void) {
+    uint64_t lo = HEAP_BASE, hi = HEAP_BASE + kernel_heap_size();
+    if (hi <= lo) return false;
+    for (int t = 0; t < T_COUNT; t++)
+        if (!g_vt[t] && !(g_vt[t] = find_class(t, lo, hi))) return false;
+    size_t cap = 65536, n = 0;
+    Ent *idx = malloc(cap * sizeof *idx);
+    if (!idx) return false;
+    uint64_t a, e;
+    for (uint64_t at = lo; plat_committed_range(at, hi, &a, &e); at = e)
+        for (uint64_t p = (a + 7) & ~7ull; p + 0x28 <= e; p += 8) {
+            uint64_t v = rd64(p);
+            int t = v == g_vt[T_BOOL] ? T_BOOL : v == g_vt[T_S32] ? T_S32 : v == g_vt[T_F32] ? T_F32 : -1;
+            if (t < 0) continue;
+            if (n == cap) {
+                Ent *more = realloc(idx, (cap *= 2) * sizeof *idx);
+                if (!more) { free(idx); return false; }
+                idx = more;
+            }
+            idx[n++] = (Ent){rd32(p + HASH_AT[t]), (uint8_t)t, p};
+        }
+    qsort(idx, n, sizeof *idx, cmp_ent);
+    free(g_idx);
+    g_idx = idx, g_n = n, g_built = time(NULL);
+    LOG("[ap] game data: %zu flags indexed\n", n);
+    return true;
+}
+
+// (no memory query per flag: the client reads thousands a second, and on Windows each VirtualQuery over the guest
+// reservation holds up the renderer's write-watch query - connected, the game fell under 1 fps. The objects are in
+// the guest window, where a page that isn't committed is committed when touched: platform/windows.c lazy_commit)
+static bool still(const Ent *x) {
+    return rd64(x->obj) == g_vt[x->type] && rd32(x->obj + HASH_AT[x->type]) == x->hash;
+}
+
+// (under g_lock) a heap pass is long: at most one try every 3 s, found or not
+static bool rebuild(void) {
+    if (time(NULL) - g_built < 3) return false;
+    g_built = time(NULL);
+    return build();
+}
+
+// (under g_lock) the flag's entry, its object checked; NULL: not there (yet)
+static const Ent *find(uint32_t hash) {
+    for (int pass = 0; pass < 2; pass++) {
+        if ((pass || !g_idx) && !rebuild()) return NULL;
+        Ent key = {hash, 0, 0};
+        const Ent *x = g_idx ? bsearch(&key, g_idx, g_n, sizeof *g_idx, cmp_ent) : NULL;
+        if (x && still(x)) return x;
+    }
+    return NULL;
+}
+
+// The value (a bool as 0 / 1, an f32 truncated); false: not found
+bool gdt_get(uint32_t hash, int32_t *out) {
+    pthread_mutex_lock(&g_lock);
+    const Ent *x = find(hash);
+    if (x) {
+        if (x->type == T_BOOL) *out = *(volatile uint8_t *)(uintptr_t)(x->obj + 0xb) & 1;
+        else if (x->type == T_S32) *out = (int32_t)rd32(x->obj + 0x18);
+        else { float f; uint32_t b = rd32(x->obj + 0x18); memcpy(&f, &b, 4); *out = (int32_t)f; }
+    }
+    pthread_mutex_unlock(&g_lock);
+    return x != NULL;
+}
+
+// A bool set, or a number raised by d (s32 / f32); false: not found
+bool gdt_change(uint32_t hash, double d, bool set) {
+    pthread_mutex_lock(&g_lock);
+    const Ent *x = find(hash);
+    if (x) {
+        volatile uint32_t *v = (volatile uint32_t *)(uintptr_t)(x->obj + 0x18);
+        if (x->type == T_BOOL) {
+            volatile uint8_t *b = (volatile uint8_t *)(uintptr_t)(x->obj + 0xb);
+            *b = (uint8_t)((*b & ~1u) | (d != 0));
+        }
+        else if (x->type == T_S32) *v = (uint32_t)((set ? 0 : (int32_t)*v) + (int32_t)d);
+        else {
+            float f;
+            uint32_t b = *v;
+            memcpy(&f, &b, 4);
+            f = set ? (float)d : f + (float)d;
+            memcpy(&b, &f, 4);
+            *v = b;
+        }
+    }
+    pthread_mutex_unlock(&g_lock);
+    return x != NULL;
+}
+
+// Every copy of a flag (the game keeps more than one): count, their objects in objs (up to max)
+int gdt_copies(uint32_t hash, uint64_t *objs, int max) {
+    pthread_mutex_lock(&g_lock);
+    int n = 0;
+    if (find(hash)) {
+        Ent key = {hash, 0, 0};
+        const Ent *x = bsearch(&key, g_idx, g_n, sizeof *g_idx, cmp_ent);
+        while (x > g_idx && x[-1].hash == hash) x--;
+        for (; x < g_idx + g_n && x->hash == hash; x++)
+            if (still(x)) { if (n < max) objs[n] = x->obj; n++; }
+    }
+    pthread_mutex_unlock(&g_lock);
+    return n;
+}
