+const char *const GAME = "Breath of the Wild";
+const int64_t LOC_BASE = 7400000000LL;
+uint32_t crc(const std::string &s) { return (uint32_t)crc32(0, (const Bytef *)s.data(), (uInt)s.size()); }
+
+// ---- notifications: (text, colour) segments, newest at the bottom
+struct Seg { std::string text; ImU32 col; };
+const ImU32 CREAM = IM_COL32(236, 228, 204, 255), GOLD = IM_COL32(243, 199, 95, 255), BLUE = IM_COL32(156, 194, 255, 255),
+            RED = IM_COL32(255, 143, 125, 255), PLAYER = IM_COL32(127, 216, 255, 255), GREY = IM_COL32(201, 194, 174, 255);
+struct Note { std::vector<Seg> segs; double born; };
+std::mutex g_note_lock;
+std::deque<Note> g_notes;
+std::deque<Note> g_history;  // (everything the room said, for the chat's scrollback)
+double now_s() { return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+void notify(std::vector<Seg> segs) {
+    std::string line;  // (the log keeps them too: what the multiworld said, for a report)
+    for (const Seg &s : segs) line += s.text;
+    LOG("[ap] chat: %s\n", line.c_str());
+    std::lock_guard<std::mutex> l(g_note_lock);
+    g_history.push_back({segs, now_s()});
+    while (g_history.size() > 300) g_history.pop_front();
+    g_notes.push_back({std::move(segs), now_s()});
+    while (g_notes.size() > 5) g_notes.pop_front();
+}
+}  // namespace
+extern "C" void ap_note(const char *text) { notify({{text, CREAM}}); }  // (the game thread's word: runtime/ap_region.c)
+namespace {
+ImU32 item_col(int flags) { return flags & 4 ? RED : flags & 1 ? GOLD : flags & 2 ? BLUE : CREAM; }
+
+// ---- the websocket
+#ifdef _WIN32
+struct Ws {
+    HINTERNET ses = nullptr, con = nullptr, req = nullptr, ws = nullptr;
+    std::mutex send_lock;
+    bool open(const std::wstring &host, int port, bool tls) {
+        ses = WinHttpOpen(L"SavageWind-Archipelago", WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY, nullptr, nullptr, 0);
+        if (!ses) return false;
+        WinHttpSetTimeouts(ses, 5000, 5000, 5000, 0);  // (receive: none - the room may be quiet for long)
+        con = WinHttpConnect(ses, host.c_str(), (INTERNET_PORT)port, 0);
+        req = con ? WinHttpOpenRequest(con, L"GET", L"/", nullptr, nullptr, nullptr, tls ? WINHTTP_FLAG_SECURE : 0) : nullptr;
+        if (!req || !WinHttpSetOption(req, WINHTTP_OPTION_UPGRADE_TO_WEB_SOCKET, nullptr, 0) ||
+            !WinHttpSendRequest(req, nullptr, 0, nullptr, 0, 0, 0) || !WinHttpReceiveResponse(req, nullptr))
+            return close(), false;
+        ws = WinHttpWebSocketCompleteUpgrade(req, 0);
+        if (!ws) return close(), false;
+        WinHttpCloseHandle(req), req = nullptr;
+        return true;
+    }
+    bool send(const std::string &s) {
+        std::lock_guard<std::mutex> l(send_lock);
+        return ws && WinHttpWebSocketSend(ws, WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE, (PVOID)s.data(), (DWORD)s.size()) == 0;
+    }
+    bool recv(std::string &out) {  // one whole message; false: closed
+        out.clear();
+        char buf[65536];
+        for (;;) {
+            DWORD n = 0;
+            WINHTTP_WEB_SOCKET_BUFFER_TYPE type;
+            if (!ws || WinHttpWebSocketReceive(ws, buf, sizeof buf, &n, &type) != 0) return false;
+            if (type == WINHTTP_WEB_SOCKET_CLOSE_BUFFER_TYPE) return false;
+            out.append(buf, n);
+            if (type == WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE || type == WINHTTP_WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE)
+                return true;
+        }
+    }
+    void close() {
+        if (ws) WinHttpWebSocketClose(ws, WINHTTP_WEB_SOCKET_SUCCESS_CLOSE_STATUS, nullptr, 0), WinHttpCloseHandle(ws);
+        if (req) WinHttpCloseHandle(req);
+        if (con) WinHttpCloseHandle(con);
+        if (ses) WinHttpCloseHandle(ses);
+        ws = req = con = ses = nullptr;
+    }
+};
+#endif
+
+// ---- the room (under g_lock)
+std::mutex g_lock;
+Ws *g_ws;
+bool g_connected;
+int g_slot = -1, g_team;
+std::string g_seed, g_slot_name;
+json g_slot_data;
+std::map<int, std::string> g_player_names, g_player_games;
+std::map<std::string, std::map<int64_t, std::string>> g_item_names, g_loc_names;  // game -> id -> name
+std::vector<json> g_items;                // ReceivedItems, in order
+json g_hints = json::array();             // the server's hints for this slot (_read_hints_<team>_<slot>)
+std::set<int64_t> g_missing, g_checked;
+std::set<std::string> g_tags;
+bool g_goal_sent;
+int g_given, g_step;                      // items carried out, and the step inside the next one
+bool g_save_count;                        // the save's AP_Given is the count (after the first look: a run from
+                                          // before has its count put in it once)
+double g_killed_at;                       // a DeathLink death: Link's own death right after isn't sent back
+int g_deaths_seen = -1;
+int32_t g_rupees_seen = -1;
+int g_weather_restore = -1;
+double g_weather_until;
+
+void trap(const std::string &kind);  // (below)
+
+void send(const json &cmds) {
+    if (g_ws) g_ws->send(cmds.dump());
+}
+
+std::string state_path() {
+    return std::string(rt_data_root()) + "/ap/" + g_seed + "_" + std::to_string(g_slot) + ".txt";
+}
+void save_state() {
+    std::string dir = std::string(rt_data_root()) + "/ap";
+    CreateDirectoryA(dir.c_str(), nullptr);
+    if (FILE *f = fopen(state_path().c_str(), "w")) fprintf(f, "%d %d %d\n", g_given, g_step, g_save_count), fclose(f);
+}
+void load_state() {
+    g_given = g_step = 0, g_save_count = false;
+    if (FILE *f = fopen(state_path().c_str(), "r")) {
+        int counted = 0;
+        if (fscanf(f, "%d %d %d", &g_given, &g_step, &counted) < 2) g_given = g_step = 0;
+        g_save_count = counted != 0;
+        fclose(f);
+    }
+}
+
+std::string item_name(int64_t id, int receiver) {
+    auto g = g_item_names.find(g_player_games[receiver]);
+    if (g != g_item_names.end() && g->second.count(id)) return g->second[id];
+    return "item " + std::to_string(id);
+}
+std::string loc_name(int64_t loc, int finder) {
+    auto g = g_loc_names.find(g_player_games[finder]);
+    if (g != g_loc_names.end() && g->second.count(loc)) return g->second[loc];
+    return "location " + std::to_string(loc);
+}
+std::string player(int slot) { return g_player_names.count(slot) ? g_player_names[slot] : "player " + std::to_string(slot); }
+
+void set_status_connected() {
+    char buf[160];
+    size_t total = g_checked.size() + g_missing.size();
+    snprintf(buf, sizeof buf, "Connected as %s: %zu of %zu checks", g_slot_name.c_str(), g_checked.size(), total);
+    ap_set_status(buf);
+}
+
+json tags_now() {
+    json t = json::array({"AP"});
+    if (g_settings.ap_deathlink) t.push_back("DeathLink");
+    if (g_settings.ap_traplink) t.push_back("TrapLink");
+    if (g_settings.ap_ringlink) t.push_back("RingLink");
+    return t;
+}
+
+// ---- packets from the server
+void on_packet(const json &p) {
+    std::string cmd = p.value("cmd", "");
+    if (cmd == "RoomInfo") {
+        g_seed = p.value("seed_name", "");
+        json games = p.value("games", json::array());
+        send(json::array({{{"cmd", "GetDataPackage"}, {"games", games}},
+                          {{"cmd", "Connect"}, {"password", g_settings.ap_password}, {"game", GAME},
+                           {"name", g_settings.ap_slot}, {"uuid", "savagewind-" + std::to_string(time(nullptr))},
+                           {"version", {{"major", 0}, {"minor", 6}, {"build", 8}, {"class", "Version"}}},
+                           {"items_handling", 7}, {"tags", tags_now()}, {"slot_data", true}}}));
+    } else if (cmd == "DataPackage") {
+        for (auto &[game, d] : p["data"]["games"].items()) {
+            for (auto &[name, id] : d["item_name_to_id"].items()) g_item_names[game][id.get<int64_t>()] = name;
+            for (auto &[name, id] : d["location_name_to_id"].items()) g_loc_names[game][id.get<int64_t>()] = name;
+        }
+    } else if (cmd == "ConnectionRefused") {
+        std::string why;
+        for (auto &e : p.value("errors", json::array())) why += (why.empty() ? "" : ", ") + e.get<std::string>();
+        ap_set_status(("Refused: " + why).c_str());
+    } else if (cmd == "Connected") {
+        g_slot = p.value("slot", -1), g_team = p.value("team", 0);
+        g_slot_data = p.value("slot_data", json::object());
+        for (auto &pl : p["players"]) g_player_names[pl.value("slot", 0)] = pl.value("alias", pl.value("name", ""));
+        for (auto &[k, v] : p["slot_info"].items()) g_player_games[std::stoi(k)] = v.value("game", "");
+        g_slot_name = player(g_slot);
+        g_missing.clear(), g_checked.clear();
+        for (auto &l : p["missing_locations"]) g_missing.insert(l.get<int64_t>());
+        for (auto &l : p["checked_locations"]) g_checked.insert(l.get<int64_t>());
+        g_tags.clear();
+        for (auto &t : tags_now()) g_tags.insert(t.get<std::string>());
+        g_items.clear(), g_goal_sent = false, g_deaths_seen = -1, g_rupees_seen = -1;
+        load_state();
+        g_connected = true;
+        g_hints = json::array();
+        std::string hk = "_read_hints_" + std::to_string(g_team) + "_" + std::to_string(g_slot);
+        send(json::array({{{"cmd", "Get"}, {"keys", {hk}}}, {{"cmd", "SetNotify"}, {"keys", {hk}}}}));
+        set_status_connected();
+        notify({{"Connected to the multiworld as ", CREAM}, {g_slot_name, PLAYER}});
+    } else if (cmd == "Retrieved" || cmd == "SetReply") {
+        std::string hk = "_read_hints_" + std::to_string(g_team) + "_" + std::to_string(g_slot);
+        json v = cmd == "Retrieved" ? p.value("keys", json::object()).value(hk, json()) :
+                 p.value("key", "") == hk ? p.value("value", json()) : json();
+        if (v.is_array()) g_hints = v;
+    } else if (cmd == "ReceivedItems") {
+        size_t index = p.value("index", 0);
+        if (index == 0) g_items.clear();
+        if (index == g_items.size())
+            for (auto &it : p["items"]) g_items.push_back(it);
+    } else if (cmd == "RoomUpdate") {
+        for (auto &l : p.value("checked_locations", json::array())) g_missing.erase(l.get<int64_t>()), g_checked.insert(l.get<int64_t>());
+        if (g_connected) set_status_connected();
+    } else if (cmd == "PrintJSON" && p.value("type", "") == "ItemSend") {
+        int to = p.value("receiving", -1);
+        const json &it = p["item"];
+        int from = it.value("player", -1), flags = it.value("flags", 0);
+        Seg item{item_name(it.value("item", (int64_t)0), to), item_col(flags)};
+        Seg loc{"  -  " + loc_name(it.value("location", (int64_t)0), from), GREY};
+        if (to == g_slot && from == g_slot) notify({{"Found your ", CREAM}, item});
+        else if (to == g_slot) notify({{"Received ", CREAM}, item, {" from ", CREAM}, {player(from), PLAYER}});
+        else if (from == g_slot) notify({{"Sent ", CREAM}, item, {" to ", CREAM}, {player(to), PLAYER}, loc});
+        else if (to == from) notify({{player(from), PLAYER}, {" found their ", CREAM}, item, loc});  // (the others' checks too)
+        else notify({{player(from), PLAYER}, {" sent ", CREAM}, item, {" to ", CREAM}, {player(to), PLAYER}, loc});
+    } else if (cmd == "PrintJSON" && p.value("type", "") != "Tutorial") {
+        // the rest the room says - chat, hints, answers to commands, who joined - as its parts, each in its colour
+        std::vector<Seg> segs;
+        auto add = [&](std::string text, ImU32 col) {
+            for (size_t nl; (nl = text.find('\n')) != std::string::npos; text.erase(0, nl + 1)) {
+                if (nl) segs.push_back({text.substr(0, nl), col});
+                if (!segs.empty()) notify(segs), segs.clear();
+            }
+            if (!text.empty()) segs.push_back({text, col});
+        };
+        for (const json &part : p.value("data", json::array())) {
+            std::string t = part.value("type", ""), text = part.value("text", "");
+            int who = part.value("player", 0);
+            if (t == "player_id") add(player(atoi(text.c_str())), PLAYER);
+            else if (t == "player_name") add(text, PLAYER);
+            else if (t == "item_id") add(item_name(atoll(text.c_str()), who), item_col(part.value("flags", 0)));
+            else if (t == "location_id") add(loc_name(atoll(text.c_str()), who), GREY);
+            else add(text, CREAM);
+        }
+        // (the server's note that WinHTTP's websocket has no compression: nothing a player can act on)
+        if (!segs.empty() && segs[0].text.find("compressed websocket") == std::string::npos) notify(segs);
+    } else if (cmd == "Bounced") {
+        json tags = p.value("tags", json::array()), d = p.value("data", json::object());
+        auto has = [&](const char *t) { return std::find(tags.begin(), tags.end(), t) != tags.end() && g_tags.count(t); };
+        if (has("DeathLink") && d.value("source", "") != g_slot_name) {
+            g_killed_at = now_s();
+            rt_link_kill();
+            notify({{"DeathLink: ", RED}, {d.value("source", "?"), PLAYER}, {" died, and so do you", CREAM}});
+        }
+        if (has("RingLink") && d.value("source", -1) != g_slot) {
+            int32_t now = 0;
+            if (gdt_get(crc("CurrentRupee"), &now)) {
+                int32_t next = std::max(0, std::min(999999, now + d.value("amount", 0)));
+                gdt_change(crc("CurrentRupee"), next, true);
+                g_rupees_seen = next;
+                notify({{"RingLink: ", BLUE}, {(d.value("amount", 0) >= 0 ? "+" : "") + std::to_string(d.value("amount", 0)) + " rupees", GOLD}});
+            }
+        }
+        if (has("TrapLink") && d.value("source", "") != g_slot_name) {
+            json traps = g_slot_data.value("traps", json::object());
+            std::string name = d.value("trap_name", "");
+            std::string kind = traps.contains(name) ? traps[name].get<std::string>() : (std::rand() % 2 ? "thunderstorm" : "midnight");
+            trap(kind);
+            notify({{"TrapLink: ", RED}, {name, RED}, {" from ", CREAM}, {d.value("source", "?"), PLAYER}});
+        }
+    }
+}
+
+// Traps (and the effects of a few filler items). The game's banner for each is the item's "!msg" scene, before this.
+//  - weather (thunderstorm, blizzard, downpour): held two minutes, as the weather command (not saved)
+//  - midnight; warp: to a random stable (the Great Plateau's and region lock's rules still apply where he lands)
+//  - no_warp / no_save / no_eat: the game's own prohibitions (WarpProhibition... the Trial of the Sword's), 90 seconds;
+//    they aren't saved, so a load ends them too
+//  - ouch: half of Link's hearts (never the last quarter); drain: 50 rupees (never below 0)
+//  - heat / cold (a minute), fire (Link burns, as on Death Mountain: 8 seconds, about 2 hearts), fog / dark (two minutes): the
+//    overlay's weather tags on their flag (AP_Env_*); bokoblins /
+//    moblins / lynels: they join the overworld's spawns (AP_Spawn_*), three minutes (botw_ap tools/give_trigger.py).
+//    The map's link tags only see a flag an event changed: these set AP_Want_<flag>, and the overlay's event copies
+//    every want onto its flag (its sync entry, AP_Q<SYNC_Q>: env_sync below), when one goes on and when it goes off
+//  - thief: one weapon, bow or shield Link isn't holding leaves the pouch (runtime/ap_event.c)
+//  - bloodmoon: the game's own Blood Moon - its night's flag (WM_BloodyDay, read by the world's code: off again after a
+//    minute, so it isn't every night) and the clock just before midnight: its scene, and every monster slain returns
+std::map<std::string, double> g_prohibit_until;  // (flag: when it goes off)
+bool g_env_sync, g_env_syncing;  // (a want changed: the overlay's event is to copy them; it is doing so)
+const char *const SYNC_Q = "128";  // (botw_ap tools/give_trigger.py SYNC)
+void trap(const std::string &kind) {
+    static const struct { const char *kind, *weather; } WEATHER[] = {
+        {"thunderstorm", "thunderstorm"}, {"blizzard", "heavy_snow"}, {"downpour", "heavy_rain"}};
+    static const struct { const char *kind, *flag; int s; } PROHIBIT[] = {
+        {"no_warp", "WarpProhibition", 90}, {"no_save", "SaveProhibition", 90}, {"no_eat", "EatProhibition", 90},
+        {"heat", "AP_Want_AP_Env_Heat", 60}, {"cold", "AP_Want_AP_Env_Cold", 60},  // (they hurt: a minute)
+        {"fire", "AP_Want_AP_Env_Fire", 8}, {"fog", "AP_Want_AP_Env_Fog", 120}, {"dark", "AP_Want_AP_Env_Dark", 120},
+        {"bokoblins", "AP_Want_AP_Spawn_Bokoblin", 120}, {"moblins", "AP_Want_AP_Spawn_Moblin", 90},
+        {"lynels", "AP_Want_AP_Spawn_Lynel", 60}, {"bloodmoon", "WM_BloodyDay", 60}};
+    for (auto &w : WEATHER)
+        if (kind == w.kind)
+            for (int i = 0; i < WEATHER_COUNT; i++)
+                if (!strcmp(g_weather_keys[i], w.weather)) {
+                    if (g_weather_restore < 0) g_weather_restore = g_settings.weather;
+                    g_settings.weather = i;  // (as the weather command: not saved; put back after two minutes)
+                    g_weather_until = now_s() + 120;
+                }
+    for (auto &p : PROHIBIT)
+        if (kind == p.kind && gdt_change(crc(p.flag), 1, true)) {
+            g_prohibit_until[p.flag] = now_s() + p.s;
+            g_env_sync |= !strncmp(p.flag, "AP_Want_", 8);
+        }
+    if (kind == "midnight") test_warp_set_hour(0);
+    else if (kind == "bloodmoon") test_warp_set_hour(23.9f);
+    else if (kind == "thief") ap_thief_request();
+    else if (kind == "ouch") {
+        uint64_t a = rt_link_life_addr();
+        if (a) {
+            int32_t life = *(volatile int32_t *)(uintptr_t)a;
+            *(volatile int32_t *)(uintptr_t)a = life / 2 > 1 ? life / 2 : 1;
+        }
+    } else if (kind == "drain") {
+        int32_t r = 0;
+        if (gdt_get(crc("CurrentRupee"), &r)) {
+            gdt_change(crc("CurrentRupee"), r > 50 ? r - 50 : 0, true);
+            if (g_rupees_seen >= 0) g_rupees_seen = r > 50 ? r - 50 : 0;  // (not the player's own spending: no RingLink)
+        }
+    } else if (kind == "warp") {
+        char line[32];
+        snprintf(line, sizeof line, "goto stable %d", 1 + std::rand() % 15);
+        control_console_submit(line);  // (the console's goto, run by the game thread as a typed one is)
+    }
+}
