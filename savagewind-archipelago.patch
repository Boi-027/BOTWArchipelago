+// ---- the map tracker: an icon on the game's map for each check still to get that is in logic, gone once it is
+// checked; the mouse over one names it. Where the map shows: AppMap draws its terrain into a 1500x720 layout capture,
+// the middle of the 1280x720 screen, as tiles 1000 m square at 2000 x scale layout units (runtime/nvn/vulkan/exec.c
+// ap_map_tile): so 2 x scale layout units a metre, and the tiles' offsets give the map's middle to within a tile. It
+// opens on Link, and from there each frame takes the place in that lattice nearest the last (a pan or zoom moves it far
+// less than a tile a frame).
+// (botw_ap tools/map_points.py: each place with what it needs in logic, as worlds/botw has it)
+struct MapPoint { uint32_t hash; float x, z; uint8_t kind; int8_t region; uint8_t need; int16_t seeds; int8_t rune, freed; };
+const MapPoint MAP_POINTS[] = {
+#include "ap_map_points.inc"
+};
+#include "ap_map_logic.inc"
+enum { NEED_GLIDER = 1, NEED_RUNES = 2, NEED_TRIAL = 4, NEED_POWERS = 8, NEED_PULL = 16, NEED_MARACAS = 32, NEED_HELM = 64,
+       NEED_ZORA = 128 };
+
+// The logic, from what has come (under g_lock)
+struct Logic {
+    std::map<int64_t, int> n;
+    bool lock;
+    int hearts;
+    bool open[15];
+    int freed;  // (the Divine Beasts freed, as bits: their "Cleared" checks done or in logic)
+    int count(int64_t id) const { auto i = n.find(id); return i == n.end() ? 0 : i->second; }
+    bool has(int64_t id) const { return count(id) > 0; }
+    bool all(const int64_t *ids, int k) const { for (int i = 0; i < k; i++) if (!has(ids[i])) return false; return true; }
+    bool ok(const MapPoint &p) const {
+        if ((p.need & NEED_GLIDER && !has(LG_PARAGLIDER)) || (p.need & NEED_RUNES && !all(LG_RUNES, 4)) ||
+            (p.rune >= 0 && !has(LG_RUNES[p.rune])) || (p.seeds && !(has(LG_MARACAS) && count(LG_KOROK) >= p.seeds)) ||
+            (p.need & NEED_TRIAL && !(all(LG_POWERS, 4) && count(LG_HEART) >= hearts && has(LG_SWORD))) ||
+            (p.need & NEED_POWERS && !all(LG_POWERS, 4)) || (p.need & NEED_PULL && count(LG_HEART) < hearts) ||
+            (p.need & NEED_MARACAS && !has(LG_MARACAS)) || (p.need & NEED_HELM && !has(LG_HELM)) ||
+            (p.need & NEED_ZORA && !has(LG_ZORA)) || (p.freed & ~freed))
+            return false;
+        if (!lock) return true;
+        if (p.region >= 0) return open[p.region];
+        for (int r = 0; r < 15; r++)  // (no one place: anywhere, so every map)
+            if (r != LG_PLATEAU && !has(LG_MAPS[r])) return false;
+        return true;
+    }
+};
+
+Logic logic_now() {
+    Logic g{};
+    for (const json &it : g_items) g.n[it.value("item", (int64_t)0)]++;
+    g.lock = g_slot_data.value("region_lock", false);
+    g.hearts = g_slot_data.value("master_sword_hearts", 10);
+    // the regions Link can reach: from the Great Plateau, a neighbour with its map (off the plateau, the paraglider)
+    int todo[15], nt = 0;
+    g.open[LG_PLATEAU] = true, todo[nt++] = LG_PLATEAU;
+    while (nt) {
+        int i = todo[--nt];
+        for (int8_t j : LG_ADJACENT[i])
+            if (j >= 0 && !g.open[j] && (j == LG_PLATEAU || g.has(LG_MAPS[j])) && (i != LG_PLATEAU || g.has(LG_PARAGLIDER)))
+                g.open[j] = true, todo[nt++] = j;
+    }
+    for (int b = 0; b < 4; b++)
+        for (const MapPoint &p : MAP_POINTS)
+            if (p.hash == LG_CLEARED[b] && (!g_missing.count(LOC_BASE + p.hash) || g.ok(p))) g.freed |= 1 << b;
+    return g;
+}
+// botw_ap tools/map_points.py KINDS: shrine, Korok, chest, shop, quest, tower, other
+const ImU32 KIND_COLOURS[] = {IM_COL32(110, 226, 240, 255), IM_COL32(126, 214, 92, 255), IM_COL32(243, 199, 95, 255),
+                              IM_COL32(255, 150, 200, 255), IM_COL32(245, 240, 225, 255), IM_COL32(255, 140, 90, 255),
+                              IM_COL32(190, 160, 255, 255)};
+// AppMap's own view (1.9.0, as runtime/pc_cursor.c reads it): its data block, or 0 when the map isn't up
+uint64_t map_data(void) {
+    auto ok = [](uint64_t p) { return p >= GUEST_LO && p < GUEST_HI; };
+    uint64_t mgr = g_site.screen_mgr ? LD64(g_site.screen_mgr) : 0;
+    if (!ok(mgr)) return 0;
+    uint64_t screens = LD64(mgr + 0x30);
+    if (!ok(screens) || LD32(mgr + 0x28) <= 0x2a) return 0;
+    uint64_t s = LD64(screens + 8 * 0x2a);
+    if (!ok(s) || LD8(s + 0xfe) != 2 || LD64(s) != 0x7001ce8298ull) return 0;
+    uint64_t map = LD64(s + 0x3628), d = ok(map) ? LD64(map + 0x8d8) : 0;
+    return ok(d) ? d : 0;
+}
+
+// What a check still needs in logic, in words (under g_lock): "" once it is in logic
+std::string needs_text(const Logic &g, const MapPoint &p) {
+    std::vector<std::string> n;
+    auto item = [&](int64_t id) { n.push_back(item_name(id, g_slot)); };
+    auto counted = [&](int need, int64_t id, const char *what) {
+        if (g.count(id) < need) n.push_back(std::to_string(need) + " " + what + " (" + std::to_string(g.count(id)) + " so far)");
+    };
+    if (p.need & NEED_GLIDER && !g.has(LG_PARAGLIDER)) item(LG_PARAGLIDER);
+    for (int i = 0; i < 4; i++)
+        if (((p.need & NEED_RUNES) || p.rune == i) && !g.has(LG_RUNES[i])) item(LG_RUNES[i]);
+    if ((p.seeds || p.need & NEED_MARACAS) && !g.has(LG_MARACAS)) item(LG_MARACAS);
+    if (p.seeds) counted(p.seeds, LG_KOROK, "Korok Seeds");
+    for (int i = 0; i < 4; i++)
+        if (p.need & (NEED_TRIAL | NEED_POWERS) && !g.has(LG_POWERS[i])) item(LG_POWERS[i]);
+    if (p.need & (NEED_TRIAL | NEED_PULL)) counted(g.hearts, LG_HEART, "Heart Containers");
+    if (p.need & NEED_TRIAL && !g.has(LG_SWORD)) item(LG_SWORD);
+    if (p.need & NEED_HELM && !g.has(LG_HELM)) item(LG_HELM);
+    if (p.need & NEED_ZORA && !g.has(LG_ZORA)) item(LG_ZORA);
+    for (int b = 0; b < 4; b++)
+        if (p.freed >> b & 1 && !(g.freed >> b & 1)) n.push_back(std::string(LG_BEASTS[b]) + " freed");
+    if (g.lock && p.region >= 0 && !g.open[p.region]) {
+        if (!g.has(LG_MAPS[p.region])) item(LG_MAPS[p.region]);
+        else n.push_back(std::string("a way into ") + LG_REGIONS[p.region] + ": a neighbouring region's map");
+    } else if (g.lock && p.region < 0) {
+        int maps = 0;
+        for (int r = 0; r < 15; r++) maps += r != LG_PLATEAU && !g.has(LG_MAPS[r]);
+        if (maps) n.push_back(std::to_string(maps) + " more region maps (it can be anywhere)");
+    }
+    std::string s;
+    for (const std::string &x : n) s += (s.empty() ? "" : ", ") + x;
+    return s;
+}
+
+// the icons under the mouse this frame, and the ones a click pinned (their details stay up until a click elsewhere)
+std::mutex g_pin_lock;
+std::vector<int64_t> g_hover_now, g_pinned;
+ImVec2 g_pinned_at, g_hover_at;  // (where the mouse was: the event thread does not touch ImGui)
+
+struct Tiles { uint64_t frame; float scale, x, y, gap; int n; };
+std::mutex g_tiles_lock;
+Tiles g_tiles_now, g_tiles_done;  // (the frame being drawn, the last whole one)
+
+void map_draw(ImGuiIO &io) {
+    static bool open, have;
+    static double cx, cz;
+    {
+        std::lock_guard<std::mutex> l(g_pin_lock);
+        g_hover_now.clear();
+        if (!framepace_map_ui()) g_pinned.clear();
+    }
+    if (!framepace_map_ui()) { open = false; return; }
+    if (!open) {  // (just opened: on Link; the last map's tiles are not this one's)
+        open = true;
+        float x, z;
+        have = ap_player_xz(&x, &z);
+        cx = x, cz = z;
+        std::lock_guard<std::mutex> l(g_tiles_lock);
+        g_tiles_now = g_tiles_done = Tiles{};
+    }
+    Tiles t;
+    {
+        std::lock_guard<std::mutex> l(g_tiles_lock);
+        t = g_tiles_done.n ? g_tiles_done : g_tiles_now;
+    }
+    // (no terrain lately: a shrine's or a Divine Beast's map, or another of the Slate's pages)
+    if (!have || !t.n || t.scale <= 0 || renderer_present_count() > t.frame + 3) return;
+    double k = 2.0 * t.scale;  // layout units a metre
+    double tile = t.gap > 1 ? t.gap / k : 1000;
+    tile = 1000 * exp2(round(log2(tile / 1000)));  // (1000 m; a finer level would halve it)
+    double bx = -6000 + tile / 2 - t.x / k, bz = -5000 + tile / 2 + t.y / k;  // (a tile's middle is a lattice point)
+    cx = bx + tile * round((cx - bx) / tile);
+    cz = bz + tile * round((cz - bz) / tile);
+    // the map's own view when it can be read (exact, and right where the game holds the view back from Hyrule's edge, which
+    // the guess from Link's place above was not): its centre in half metres, x the other way; its zoom the tiles' scale
+    if (uint64_t d = map_data()) {
+        float c0 = *(float *)(uintptr_t)(d + 0x880), c1 = *(float *)(uintptr_t)(d + 0x884), z = *(float *)(uintptr_t)(d + 0x878);
+        if (z > 0.005f && z < 50 && fabsf(c0) < 20000 && fabsf(c1) < 20000) cx = -c0 / 2, cz = c1 / 2, k = 2.0 * z;
+    }
+    // the 16:9 screen in the window (a wider or taller window keeps the map 16:9 in its middle), and the map's part of
+    // it between the frame's top and bottom bars
+    float ppl = fminf(io.DisplaySize.x / 1280, io.DisplaySize.y / 720), mx = io.DisplaySize.x / 2, my = io.DisplaySize.y / 2;
+    ImVec2 lo(mx - 620 * ppl, my - 300 * ppl), hi(mx + 620 * ppl, my + 296 * ppl);
+    float r = ppl * (2.4f + 1.8f * fminf(1.f, (float)k / 0.6f));
+    // the icons (botw_ap tools/map_icons.py: from the player's own game files, into the overlay at Set up), once; dots
+    // without them
+    static ImTextureID icons;
+    static bool icons_tried;
+    if (!icons_tried) {
+        icons_tried = true;
+        const char *ov = getenv("SAVAGEWIND_ROMFS_OVERLAY");
+        std::string path = std::string(ov ? ov : "") + "/ap_map_icons.png";
+        int w = 0, h = 0;
+        if (ov && *ov) {
+            if (unsigned char *px = rt_image_rgba(path.c_str(), &w, &h)) {
+                if (w == h * 7) icons = (ImTextureID)vk_imgui_texture_rgba(px, w, h);
+                rt_image_free(px);
+            }
+        }
+    }
+    float half = icons ? ppl * (5.5f + 4.5f * fminf(1.f, (float)k / 0.6f)) : r;  // (an icon's half width)
+    ImDrawList *dl = ImGui::GetBackgroundDrawList();
+    dl->PushClipRect(lo, hi, false);
+    std::vector<int64_t> hover;
+    ImVec2 mouse(-1e9f, -1e9f);
+    // (the mouse, while it is what was used last; io.MousePos: only while one of our menus has it, on the map the game has)
+    if (pc_cursor_mouse_last()) menu_mouse_pos(&mouse.x, &mouse.y);
+    std::lock_guard<std::mutex> l(g_lock);
+    if (!g_connected) { dl->PopClipRect(); return; }
+    Logic lg = logic_now();
+    static std::vector<int8_t> state;  // (each place this frame: -1 not a check still to get or not on screen, 0 out of logic, 1 in)
+    state.assign(sizeof MAP_POINTS / sizeof *MAP_POINTS, -1);
+    for (size_t i = 0; i < state.size(); i++) {
+        const MapPoint &p = MAP_POINTS[i];
+        float sx = mx + (float)((p.x - cx) * k) * ppl, sy = my + (float)((p.z - cz) * k) * ppl;
+        if (sx < lo.x - half || sx > hi.x + half || sy < lo.y - half || sy > hi.y + half) continue;
+        if (g_missing.count(LOC_BASE + p.hash)) state[i] = lg.ok(p);
+    }
+    // out of logic dimmed under the rest; within each, the commonest under the rest: Korok seeds, chests, shops, others,
+    // quests, shrines, towers
+    static const uint8_t ORDER[] = {1, 2, 3, 6, 4, 0, 5};
+    for (int in : {0, 1})
+        for (uint8_t kind : ORDER)
+            for (size_t i = 0; i < state.size(); i++) {
+                const MapPoint &p = MAP_POINTS[i];
+                if (state[i] != in || p.kind != kind) continue;
+                float sx = mx + (float)((p.x - cx) * k) * ppl, sy = my + (float)((p.z - cz) * k) * ppl;
+                float h = in ? half : half * 0.8f;
+                if (icons) {
+                    dl->AddImage(icons, ImVec2(sx - h, sy - h), ImVec2(sx + h, sy + h), ImVec2(kind / 7.f, 0),
+                                 ImVec2((kind + 1) / 7.f, 1), in ? IM_COL32_WHITE : IM_COL32(175, 175, 175, 140));
+                } else {
+                    dl->AddCircleFilled(ImVec2(sx, sy), r + ppl * 0.9f, IM_COL32(10, 14, 16, in ? 200 : 80), 12);
+                    dl->AddCircleFilled(ImVec2(sx, sy), r, (KIND_COLOURS[kind % 7] & 0x00ffffff) | (in ? 0xff000000u : 0x60000000u), 12);
+                }
+                float dx = mouse.x - sx, dy = mouse.y - sy, reach = h * 0.8f + 2 * ppl;
+                if (dx * dx + dy * dy <= reach * reach) hover.push_back(LOC_BASE + p.hash);
+            }
+    dl->PopClipRect();
+    // the details: the pinned ones (a click), else the ones under the mouse; the topmost (drawn last) first
+    std::reverse(hover.begin(), hover.end());
+    if (hover.size() > 5) hover.resize(5);
+    std::vector<int64_t> show;
+    ImVec2 at = mouse;
+    {
+        std::lock_guard<std::mutex> pl(g_pin_lock);
+        g_hover_now = hover, g_hover_at = mouse;
+        show = g_pinned.empty() ? hover : g_pinned;
+        if (!g_pinned.empty()) at = g_pinned_at;
+    }
+    if (show.empty()) return;
+    ImFont *f = g_game_font ? g_game_font : ImGui::GetFont();
+    float fs = 22 * ppl / 1.5f, small = 17 * ppl / 1.5f, pad = 9 * ppl / 1.5f, wrap = 520 * ppl / 1.5f, w = 0, hgt = 0;
+    struct Line { std::string text; float size; ImU32 colour; };
+    std::vector<Line> lines;
+    for (int64_t id : show) {
+        const MapPoint *p = nullptr;
+        for (const MapPoint &q : MAP_POINTS) if (LOC_BASE + q.hash == id) { p = &q; break; }
+        if (!lines.empty()) lines.push_back({"", small * 0.5f, 0});
+        lines.push_back({loc_name(id, g_slot), fs, IM_COL32(245, 240, 225, 255)});
+        if (!g_missing.count(id)) lines.push_back({"Done", small, IM_COL32(170, 170, 160, 255)});
+        else if (std::string need = p ? needs_text(lg, *p) : ""; need.empty())
+            lines.push_back({"In logic: you can get it now", small, IM_COL32(140, 225, 120, 255)});
+        else
+            lines.push_back({"Needs: " + need, small, IM_COL32(255, 180, 110, 255)});
+    }
+    for (const Line &x : lines) {
+        ImVec2 sz = f->CalcTextSizeA(x.size, FLT_MAX, wrap, x.text.c_str());
+        w = fmaxf(w, sz.x), hgt += x.text.empty() ? x.size : sz.y + 2 * ppl;
+    }
+    ImVec2 a(at.x + 18 * ppl / 1.5f, at.y - pad), b(a.x + w + 2 * pad, a.y + hgt + 2 * pad);
+    if (b.x > io.DisplaySize.x) a.x -= b.x - io.DisplaySize.x, b.x = io.DisplaySize.x;
+    if (b.y > io.DisplaySize.y) a.y -= b.y - io.DisplaySize.y, b.y = io.DisplaySize.y;
+    ImDrawList *fg = ImGui::GetForegroundDrawList();
+    fg->AddRectFilled(a, b, IM_COL32(12, 14, 13, 225), 6 * ppl / 1.5f);
+    float y = a.y + pad;
+    for (const Line &x : lines) {
+        if (x.text.empty()) { y += x.size; continue; }
+        fg->AddText(f, x.size, ImVec2(a.x + pad, y), x.colour, x.text.c_str(), nullptr, wrap);
+        y += f->CalcTextSizeA(x.size, FLT_MAX, wrap, x.text.c_str()).y + 2 * ppl;
+    }
+}
+
+}  // namespace
+
+// (menu.mm, a left click while no menu of ours is up) a click on a map tracker icon pins its details and is not the game's;
+// one elsewhere lets go of them (and is)
+extern "C" bool ap_map_click(bool down) {
+    std::lock_guard<std::mutex> l(g_pin_lock);
+    static bool eat_up;
+    if (!down) { bool e = eat_up; eat_up = false; return e; }
+    if (!framepace_map_ui() || g_hover_now.empty()) { g_pinned.clear(); return false; }
+    g_pinned = g_hover_now, g_pinned_at = g_hover_at, eat_up = true;
+    return true;
+}
+
+// (runtime/nvn/vulkan/exec.c, the recording thread: each terrain tile AppMap draws, as its scale and offset)
+extern "C" void ap_map_tile(float scale, float x, float y) {
+    uint64_t f = renderer_present_count();
+    std::lock_guard<std::mutex> l(g_tiles_lock);
+    Tiles &t = g_tiles_now;
+    if (f != t.frame || scale != t.scale) {  // (a new frame, or a new zoom: begin again)
+        if (t.n && f != t.frame) g_tiles_done = t;
+        t = Tiles{f, scale, x, y, 0, 0};
+    }
+    float d = fabsf(x - t.x);  // (the tiles' spacing: the nearest other column's)
+    if (d > 1 && (!t.gap || d < t.gap)) t.gap = d;
+    t.n++;
+}
+
+extern "C" bool ap_chat_is_open(void) { return g_chat_open.load(); }
+extern "C" void ap_chat_set_open(bool open) {
+    if (open && !g_chat_open.load()) g_chat_appearing = true;
+    g_chat_open = open;
+}
+// Enter opens it only out in the world (not a menu, talk, scene or pause: there Enter is the A button) with a room set
+extern "C" bool ap_chat_can_open(void) {
+    return g_settings.ap_server[0] && in_world() && !framepace_menu_ui() && !framepace_paused() && !framepace_in_event();
+}
+
+// Every frame (menu.mm's menu_draws): starts the client once; true while a notification or the chat is up, so the
+// overlay draws
+bool ap_overlay_active(void) {
+    static std::once_flag started;
+    std::call_once(started, [] { std::thread(net_thread).detach(); std::thread(tick_thread).detach(); });
+    if (ap_region_fog() > 0.004f) return true;  // (the region lock's fog: every frame, not only while a note is up)
+    if (framepace_map_ui() && g_settings.ap_server[0]) return true;  // (the map tracker's dots)
+    std::lock_guard<std::mutex> l(g_note_lock);
+    return !g_notes.empty() || g_chat_open.load();
+}
+
+// The notifications, bottom left, as the game shows what Link picks up: a dark band fading out to the right between
+// thin light rules, a Sheikah-blue mark, the game's own font. With the chat open, the room's log takes their place.
+// Called every frame from menu.mm (outside the menus); the first call starts the client.
+void ap_overlay_draw(ImGuiIO &io, float scale, ImFont *game_font) {
+    // region lock's fog (runtime/ap_region.c): a pale haze over the world, thicker below, white when it turns Link back
+    float fog = ap_region_fog();
+    if (fog > 0.004f) {
+        ImDrawList *bg = ImGui::GetBackgroundDrawList();
+        float a = fminf(1.f, fog * 1.08f);
+        ImU32 top = IM_COL32(222, 226, 226, (int)(255 * a * 0.82f)), low = IM_COL32(232, 235, 233, (int)(255 * a));
+        bg->AddRectFilledMultiColor(ImVec2(0, 0), io.DisplaySize, top, top, low, low);
+    }
+    {
+        std::lock_guard<std::mutex> l(g_note_lock);
+        g_game_font = game_font;  // (this frame's: a font rebuild frees the last one, and the map's details use it too)
+    }
+    map_draw(io);
+    std::lock_guard<std::mutex> l(g_note_lock);
+    double t = now_s();
+    while (!g_notes.empty() && t - g_notes.front().born > 7.3) g_notes.pop_front();
+    if (g_chat_open.load()) return chat_draw(io, scale);
+    ImDrawList *dl = ImGui::GetForegroundDrawList();
+    float fs = 28 * scale, h = fs * 1.55f, gap = 6 * scale, pad = 14 * scale;
+    float y = io.DisplaySize.y - io.DisplaySize.y * 0.14f - g_notes.size() * (h + gap);
+    for (const Note &n : g_notes) {
+        double age = t - n.born;
+        float in = (float)fmin(1.0, age / 0.22), out = age > 7.0 ? (float)fmin(1.0, (age - 7.0) / 0.3) : 0.f;
+        float w = 30 * scale + pad + segs_width(n.segs, fs);
+        float slide = 1 - (1 - in) * (1 - in) * (1 - in), alpha = in * (1 - out);
+        float x = 24 * scale - 40 * scale * (1 - slide);
+        draw_band(dl, ImVec2(x, y), ImVec2(x + w, y + h), 60 * scale, alpha);
+        draw_mark(dl, x + pad + 4 * scale, y + h / 2, 5.5f * scale, alpha);
+        draw_segs(dl, ImVec2(x + pad + 18 * scale, y + (h - fs) / 2), fs, n.segs, alpha);
+        y += h + gap;
+    }
+}
+
+// (the console's `ap`: where the client is - what holds the items back when none arrive)
+extern "C" void ap_client_state(char *buf, size_t n) {
+    std::lock_guard<std::mutex> l(g_lock);
+    int32_t pending = -1, done = -1;
+    gdt_get(crc("AP_Pending"), &pending), gdt_get(crc("AP_Done"), &done);
+    // (and the map tracker: its terrain tiles lately, the checks missing and in logic, what the logic sees)
+    Tiles t;
+    {
+        std::lock_guard<std::mutex> tl(g_tiles_lock);
+        t = g_tiles_done.n ? g_tiles_done : g_tiles_now;
+    }
+    Logic lg = logic_now();
+    int missing = 0, in_logic = 0, open = 0;
+    for (const MapPoint &p : MAP_POINTS)
+        if (g_missing.count(LOC_BASE + p.hash)) missing++, in_logic += lg.ok(p);
+    for (int r = 0; r < 15; r++) open |= lg.open[r] << r;
+    snprintf(buf, n, "connected=%d world=%d sync=%d syncing=%d raised=%d event=%d pending=%d done=%d given=%d/%zu step=%d "
+             "map: tiles=%d scale=%g age=%lld missing=%d inlogic=%d glider=%d runes=%d%d%d%d lock=%d open=%x freed=%x",
+             g_connected, in_world(), g_env_sync, g_env_syncing, g_demo_raised, framepace_in_event(), pending, done, g_given,
+             g_items.size(), g_step, t.n, t.scale, (long long)(renderer_present_count() - t.frame), missing, in_logic,
+             lg.has(LG_PARAGLIDER), lg.has(LG_RUNES[0]), lg.has(LG_RUNES[1]), lg.has(LG_RUNES[2]), lg.has(LG_RUNES[3]),
+             lg.lock, open, lg.freed);
+}
